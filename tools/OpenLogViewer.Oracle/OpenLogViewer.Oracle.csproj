<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The reference the Rust port is measured against. Runs the shipping C# over
    synthetic inputs and over the local corpus, and writes what it got to
    rust/oracle/expected. Deleted with the rest of the C# at cut-over.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenLogViewer.Core\OpenLogViewer.Core.csproj" />
    <!-- The MCP server is an Exe with no public surface; W5Mcp calls its Answer by reflection. -->
    <ProjectReference Include="..\OpenLogViewer.Mcp\OpenLogViewer.Mcp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>olv-oracle</AssemblyName>
  </PropertyGroup>

</Project>
