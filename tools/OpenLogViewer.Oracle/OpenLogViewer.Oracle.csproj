<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The reference the Rust port is measured against. Runs the shipping C# over
    synthetic inputs and over the local corpus, and writes what it got to
    rust/oracle/expected. Deleted with the rest of the C# at cut-over.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenLogViewer.Core\OpenLogViewer.Core.csproj" />
  </ItemGroup>

  <!--
    The theme maths is WPF-side code in the App project, which this tool cannot reference (it
    targets Windows, this does not). The three files that hold the formulas are compiled in as
    they are, with the WPF colour types they use stood in for by Shims/WpfColorShim.cs.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\OpenLogViewer.App\ColorMath.cs" Link="Linked\ColorMath.cs" />
    <Compile Include="..\..\src\OpenLogViewer.App\Theme.cs" Link="Linked\Theme.cs" />
    <Compile Include="..\..\src\OpenLogViewer.App\ThemeCatalog.cs" Link="Linked\ThemeCatalog.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>olv-oracle</AssemblyName>
  </PropertyGroup>

</Project>
