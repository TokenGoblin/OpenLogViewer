<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenLogViewer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serial port access for a live ECU connection. Microsoft-published and
         part of the .NET libraries, but a package rather than in the framework
         since .NET Core; the alternative is hand-rolled P/Invoke to the Win32
         comms API, which is more code and more ways to be subtly wrong. -->
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
  </ItemGroup>

</Project>
