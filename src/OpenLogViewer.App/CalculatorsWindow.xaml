                                   TextChanged="OnOctaneChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}" x:Name="OctMixNote"/>

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Anti-knock index"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="OctAki"
                                   Style="{StaticResource Answer}" FontSize="19" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="(R+M)/2 — compare against the pump"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="RON / MON"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="OctRonMon"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}" x:Name="OctSensNote"/>

                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Heat of vaporisation"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="OctHov"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}" x:Name="OctHovNote"/>

                        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Charge cooling"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="OctCooling"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource Unit}" x:Name="OctCoolingNote"/>
                    </Grid>

                    <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="5"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="OctChartTitle"
                                       Foreground="{DynamicResource Text}" FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="OctChart" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource Muted}"/>

                            <TextBlock x:Name="OctCoolingTitle"
                                       Foreground="{DynamicResource Text}" FontSize="11"
                                       Margin="0,12,0,6"/>
                            <TextBlock x:Name="OctCoolingChart" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Note}"
                               Text="Octane blends very nearly linearly by molecule rather than by volume. Ethanol's molar mass is 46 against petrol's 105 and it is denser, so a tenth of the volume is a fifth of the molecules — which is the whole of why the first splash is worth so much more than the last. Estimated on that basis (Anderson et al., SAE 2012-01-1274), and checked against measured blends: on an 88 RON blendstock this gives 92.4 at E10 and 98.7 at E30, where the measurements are 92.4 and 98.6."/>

                    <TextBlock Style="{StaticResource Note}"
                               Text="Two cautions. A pump number is the average of RON and MON, and blending alcohol in raises RON much harder than MON — so the index understates what a boosted or direct-injected engine actually gets, since those run nearer the RON end. And the cooling below is what the fuel can absorb, not what the charge keeps: a port-injected engine gives much of it back to the manifold walls, where a direct-injected one collects nearly all of it."/>

                    <TextBlock Style="{StaticResource Note}" x:Name="OctNote"/>
                </StackPanel>
            </ScrollViewer>

