                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="14"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Base petrol"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="OctBase" Style="{StaticResource Field}"
                                   TextChanged="OnOctaneChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="(R+M)/2 — the number on a US pump"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Sensitivity"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="OctSensitivity" Style="{StaticResource Field}"
                                   TextChanged="OnOctaneChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="RON − MON — pump petrol is 7 to 10"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Blend with"/>
                        <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="OctStock" Width="150" Margin="0,2"
                                   HorizontalAlignment="Left" SelectionChanged="OnOctaneStockChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" x:Name="OctStockNote"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Blended in"/>
