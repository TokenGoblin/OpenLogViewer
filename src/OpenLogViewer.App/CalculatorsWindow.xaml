                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="rpm"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Volumetric efficiency"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="AirVe" Style="{StaticResource Field}"
                                   TextChanged="OnAirflowChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="% — 80 ordinary, 100 good, more at resonance"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Boost"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="AirBoost" Style="{StaticResource Field}"
                                   TextChanged="OnAirflowChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}" x:Name="AirRatio"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Lambda"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="AirLambda" Style="{StaticResource Field}"
                                   TextChanged="OnAirflowChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}"
                                   x:Name="AirLambdaNote"/>

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="BSFC on petrol"/>
                        <TextBox   Grid.Row="5" Grid.Column="1" x:Name="AirBsfc" Style="{StaticResource Field}"
                                   TextChanged="OnAirflowChanged"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="lb/hp/hr — efficiency, not the sizing figure"/>

                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Air demanded"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="AirCfm"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}" Text="cfm"/>

                        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Air demanded"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="AirLbMin"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="lb/min — the units a compressor map uses"/>

                        <TextBlock Grid.Row="9" Style="{StaticResource Label}" Text="Air demanded"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" x:Name="AirM3h"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource Unit}" Text="m³/hour"/>

                        <TextBlock Grid.Row="11" Style="{StaticResource Label}" Text="Power on petrol"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" x:Name="AirHpPetrol"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource Unit}"
                                   x:Name="AirHpPetrolNote"/>

                        <TextBlock Grid.Row="12" Style="{StaticResource Label}" Text="Power on ethanol"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" x:Name="AirHpEthanol"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="12" Grid.Column="2" Style="{StaticResource Unit}"
                                   x:Name="AirHpEthanolNote"/>

                        <TextBlock Grid.Row="13" Style="{StaticResource Label}" Text="Power on methanol"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" x:Name="AirHpMethanol"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="13" Grid.Column="2" Style="{StaticResource Unit}"
                                   x:Name="AirHpMethanolNote"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Note}" x:Name="AirPowerNote"/>

                    <TextBlock Style="{StaticResource Note}"
                               Text="Demand, not delivery: this is what the engine would swallow at that speed and filling. What actually goes in is limited by whatever is upstream — the throttle, the intercooler, the filter and the compressor's own map."/>

                    <TextBlock Style="{StaticResource Note}" x:Name="AirBaroNote"/>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </DockPanel>
</Window>
