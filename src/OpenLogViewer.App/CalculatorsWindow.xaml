<Window x:Class="OpenLogViewer.App.CalculatorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculators"
        Height="760" Width="840"
        MinHeight="460" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        ShowInTaskbar="False">

    <Window.Resources>
        <!--
            Every numeric field selects itself when it takes focus, so typing
            replaces the number rather than joining onto it. These boxes hold
            working values rather than placeholders — the window computes as you
            type — so emptying them on focus would leave a page of dashes, and
            ghost text would mean nothing to read until eight boxes were filled.
            A second click still places the caret for editing one digit.
        -->
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,2"/>
            <EventSetter Event="GotKeyboardFocus" Handler="OnFieldFocused"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnFieldClicked"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>

        <Style x:Key="Answer" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="0,16,0,5"/>
        </Style>
        <!--
            One row of the calculator list. A ListBoxItem rather than a tab
            because the list has to grow: tabs run out of width at about eight
            and there are already nine, where a list down the side takes as many
            as anyone cares to add and groups them while it is at it.
        -->
        <Style x:Key="NavRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent" CornerRadius="5"
                                Margin="0,1" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Panel}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel Background="{DynamicResource Bg}">
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Width="80" Click="OnCloseClick"/>
                <TextBlock VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                           Text="Every figure updates as you type."/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Left" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <ListBox x:Name="Nav" Width="150" Margin="6,8"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnNavChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="10,10,0,3"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}"
                                           Opacity="0.75"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
        </Border>

        <Grid x:Name="Pages" Margin="8">

            <!-- ===== the whole build ===== -->
            <ScrollViewer x:Name="PageRecipe" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="One build, worked through end to end. Say what the engine is and what you want of it, and every part of the list comes back sized on the same assumptions."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Displacement"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="RecLitres" Style="{StaticResource Field}"
                                   TextChanged="OnRecipeChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" x:Name="RecLitresNote"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Cylinders"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="RecCylinders" Style="{StaticResource Field}"
                                   TextChanged="OnRecipeChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="one injector each"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Target power"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="RecPower" Style="{StaticResource Field}"
                                   TextChanged="OnRecipeChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" x:Name="RecPowerNote"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Peak torque at"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="RecTorqueRpm" Style="{StaticResource Field}"
                                   TextChanged="OnRecipeChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="rpm — where you want full boost by"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Peak power at"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="RecPowerRpm" Style="{StaticResource Field}"
                                   TextChanged="OnRecipeChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}" x:Name="RecPistonNote"/>

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Fuel"/>
                        <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="RecFuel" Width="150" Margin="0,2"
                                   HorizontalAlignment="Left" SelectionChanged="OnRecipeFuelChanged"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}" x:Name="RecFuelNote"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Lambda"/>
                        <TextBox   Grid.Row="6" Grid.Column="1" x:Name="RecLambda" Style="{StaticResource Field}"
                                   TextChanged="OnRecipeChanged"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}" x:Name="RecLambdaNote"/>

                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Head and cams"/>
                        <ComboBox  Grid.Row="7" Grid.Column="1" x:Name="RecVeFamily" Width="150" Margin="0,2"
                                   HorizontalAlignment="Left" SelectionChanged="OnRecipeVeFamilyChanged"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}" x:Name="RecVeNote"/>

                        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Volumetric efficiency"/>
                        <TextBox   Grid.Row="8" Grid.Column="1" x:Name="RecVe" Style="{StaticResource Field}"
                                   TextChanged="OnRecipeChanged"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="% — type your own and the list follows"/>

                        <TextBlock Grid.Row="9" Style="{StaticResource Label}" Text="Charge temperature"/>
                        <TextBox   Grid.Row="9" Grid.Column="1" x:Name="RecChargeTemp" Style="{StaticResource Field}"
                                   TextChanged="OnRecipeChanged"/>
                        <StackPanel Grid.Row="9" Grid.Column="2" Orientation="Horizontal">
                            <ComboBox x:Name="RecTempUnit" Width="62" Margin="8,2,0,2"
                                      SelectionChanged="OnRecipeTempUnitChanged"/>
                            <TextBlock Style="{StaticResource Unit}" x:Name="RecTempNote"/>
                        </StackPanel>

                        <TextBlock Grid.Row="11" Style="{StaticResource Label}" Text="Injector duty limit"/>
                        <TextBox   Grid.Row="11" Grid.Column="1" x:Name="RecDuty" Style="{StaticResource Field}"
                                   TextChanged="OnRecipeChanged"/>
                        <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource Unit}" x:Name="RecDutyNote"/>

                        <TextBlock Grid.Row="12" Style="{StaticResource Label}" Text="Pump headroom"/>
                        <TextBox   Grid.Row="12" Grid.Column="1" x:Name="RecPumpHeadroom" Style="{StaticResource Field}"
                                   TextChanged="OnRecipeChanged"/>
                        <TextBlock Grid.Row="12" Grid.Column="2" Style="{StaticResource Unit}" x:Name="RecPumpNote"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Heading}" Text="THE RECIPE"/>

                    <Border Padding="12,10" CornerRadius="5"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <TextBlock x:Name="RecList" FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource Text}"/>
                    </Border>

                    <TextBlock Style="{StaticResource Heading}" Text="WORTH KNOWING"
                               x:Name="RecWarningsHeading"/>

                    <ItemsControl x:Name="RecWarnings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Border DockPanel.Dock="Left" Width="52" Height="18" CornerRadius="3"
                                            Margin="0,1,8,0" VerticalAlignment="Top"
                                            Background="{Binding Tint}">
                                        <TextBlock Text="{Binding Severity}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Bg}" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Muted}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Note}"
                               Text="Every part of this list is sized on one mixture and one fuel consumption, so the pieces match each other. The margins are separate and named — duty on the injectors, headroom on the pump, flow to spare on the compressor — so being more careful is a matter of moving a margin rather than quietly biasing an assumption."/>

                    <TextBlock Style="{StaticResource Note}"
                               Text="The torque speed is not decoration. Airflow at the power peak says whether a compressor is large enough; airflow at the torque peak says whether it is too large. A turbocharger with plenty left at 7,000 rpm can be sitting off the left of its map at 3,500 and never spool — which is why two builds wanting the same power can want different turbochargers."/>

                    <TextBlock Style="{StaticResource Note}"
                               Text="A starting point, not a build sheet. Nothing here knows about your cylinder head, your cam, your gearbox or what the engine is bolted into, and every figure carries the fuel consumption that was assumed rather than measured. Take it to the individual calculators to argue with the parts one at a time."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== pressure ===== -->
            <ScrollViewer x:Name="PageBoost" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,10"
                               Text="Type into any box; the others follow."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="14"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Boost (gauge)"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="BoostPsi" Style="{StaticResource Field}"
                                   TextChanged="OnBoostPsiChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="psi"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Boost (gauge)"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="BoostBar" Style="{StaticResource Field}"
                                   TextChanged="OnBoostBarChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="bar"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Boost (gauge)"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="BoostKpa" Style="{StaticResource Field}"
                                   TextChanged="OnBoostKpaChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" Text="kPa"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Manifold pressure"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="MapKpa" Style="{StaticResource Field}"
                                   TextChanged="OnMapKpaChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="kPa absolute — what an ECU reports"/>

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Manifold pressure"/>
                        <TextBox   Grid.Row="5" Grid.Column="1" x:Name="MapPsi" Style="{StaticResource Field}"
                                   TextChanged="OnMapPsiChanged"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}" Text="psi absolute"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Charge density"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="PressureRatio"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="× sea-level air"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Note}"
                               Text="A boost gauge reads zero at atmospheric; an ECU reports manifold pressure absolutely, where atmospheric is about 101 kPa. Ten psi of boost is 170 kPa absolute, not 69 — mixing the two up is worth a whole atmosphere."/>

                    <TextBlock Style="{StaticResource Note}" x:Name="BoostBaroNote"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== compressor ===== -->
            <ScrollViewer x:Name="PagePressureRatio" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/>
                            <RowDefinition Height="14"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Boost (gauge)"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="PrBoost" Style="{StaticResource Field}"
                                   TextChanged="OnCompressorChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="psi at the manifold"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Altitude"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PrAltitude" Style="{StaticResource Field}"
                                   TextChanged="OnAltitudeChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" x:Name="PrAltitudeNote"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Barometric pressure"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PrBarometric" Style="{StaticResource Field}"
                                   TextChanged="OnBarometricChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="kPa — your ECU's own reading beats the altitude"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Inlet loss"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="PrInletLoss" Style="{StaticResource Field}"
                                   TextChanged="OnCompressorChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="psi — air filter and the pipe to the turbo"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Charge loss"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="PrChargeLoss" Style="{StaticResource Field}"
                                   TextChanged="OnCompressorChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="psi — intercooler and charge pipe"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Compressor inlet"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="PrInlet"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="psi absolute — below ambient, past the filter"/>

                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Compressor outlet"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="PrOutlet"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="psi absolute — above the manifold, past the intercooler"/>

                        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Pressure ratio"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="PrRatio"
                                   Style="{StaticResource Answer}" FontSize="19" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="what to read the compressor map at"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Note}" x:Name="PrNote"/>

                    <TextBlock Style="{StaticResource Note}"
                               Text="Outlet over inlet, both absolute and both taken at the compressor rather than at the manifold — which is why it is not simply boost over atmospheric. Both losses push it up, so a compressor picked without them is picked on a smaller number than it will be asked for."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== injectors ===== -->
            <ScrollViewer x:Name="PageInjectors" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/>
                            <RowDefinition Height="14"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Target power"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="InjPower" Style="{StaticResource Field}"
                                   TextChanged="OnInjectorChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="hp at the crank"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Cylinders"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="InjCylinders" Style="{StaticResource Field}"
                                   TextChanged="OnInjectorChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="one injector each"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Fuel"/>
                        <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="InjFuel" Width="150" Margin="0,2" HorizontalAlignment="Left"
                                   SelectionChanged="OnInjectorFuelChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" x:Name="InjFuelNote"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="BSFC"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="InjBsfc" Style="{StaticResource Field}"
                                   TextChanged="OnInjectorChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}"
                                   x:Name="InjBsfcHint"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Maximum duty"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="InjDuty" Style="{StaticResource Field}"
                                   TextChanged="OnInjectorChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="% — above 85 many stop flowing linearly"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Each injector"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="InjCc"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}" Text="cc/min"/>

                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Each injector"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="InjLbHr"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}" Text="lb/hr"/>

                        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="All injectors"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="InjTotal"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource Unit}" Text="cc/min together"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Note}" x:Name="InjNote"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== fuel pump ===== -->
            <ScrollViewer x:Name="PageFuelPump" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/>
                            <RowDefinition Height="14"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Target power"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="PumpPower" Style="{StaticResource Field}"
                                   TextChanged="OnPumpChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="hp at the crank"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Fuel"/>
                        <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="PumpFuel" Width="150" Margin="0,2" HorizontalAlignment="Left"
                                   SelectionChanged="OnPumpFuelChanged"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="BSFC"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PumpBsfc" Style="{StaticResource Field}"
                                   TextChanged="OnPumpChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}"
                                   x:Name="PumpBsfcHint"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Headroom"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="PumpHeadroom" Style="{StaticResource Field}"
                                   TextChanged="OnPumpChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="% over what is burned"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Base rail pressure"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="PumpRailPsi" Style="{StaticResource Field}"
                                   TextChanged="OnPumpChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="psi with no boost on it"/>

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Boost"/>
                        <TextBox   Grid.Row="5" Grid.Column="1" x:Name="PumpBoost" Style="{StaticResource Field}"
                                   TextChanged="OnPumpChanged"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}"
                                   x:Name="PumpRailNote"/>

                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Fuel burned"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="PumpBurned"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}" Text="litres/hour"/>

                        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Pump to look for"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="PumpNeeded"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="litres/hour delivered at that pressure"/>

                        <TextBlock Grid.Row="9" Style="{StaticResource Label}" Text="Same in"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" x:Name="PumpGallons"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource Unit}" x:Name="PumpGallonsNote"/>
                    </Grid>

                    <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="5"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="PumpPicksTitle"
                                       Foreground="{DynamicResource Text}" FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="PumpPicks" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Note}" x:Name="PumpPicksNote"/>

                    <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="5"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Typical BSFC, lb per hp per hour"
                                       Foreground="{DynamicResource Text}" FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="PumpLegend" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Note}" x:Name="PumpLegendNote"/>

                    <TextBlock Style="{StaticResource Note}"
                               Text="A pump's headline figure is quoted at some pressure, usually low and often at 13.5 volts. Flow falls as rail pressure rises and as voltage sags, so compare against the maker's curve at your own pressure rather than against the number on the box."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== lambda ===== -->
            <ScrollViewer x:Name="PageLambda" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="14"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Fuel"/>
                        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="LambdaFuel" Width="150" Margin="0,2" HorizontalAlignment="Left"
                                   SelectionChanged="OnLambdaFuelChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" x:Name="LambdaStoich"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Lambda"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="LambdaValue" Style="{StaticResource Field}"
                                   TextChanged="OnLambdaChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="1.00 is stoichiometric on any fuel"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Air-fuel ratio"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="AfrValue" Style="{StaticResource Field}"
                                   TextChanged="OnAfrChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" x:Name="AfrNote"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Reads as"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LambdaVerdict"
                                   Foreground="{DynamicResource Accent}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Note}"
                               Text="Lambda is the same number on every fuel, which is why it is worth using. 12.5:1 is comfortably rich on petrol and lean enough to hurt on E85 — the same mixture is 0.85 on both."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== engine ===== -->
            <ScrollViewer x:Name="PageEngine" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Text="Bore and stroke decide all three of these, so they are asked for once."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="14"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="14"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="14"/>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Bore"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="EngBore" Style="{StaticResource Field}"
                                   TextChanged="OnEngineChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" x:Name="EngBoreNote"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Stroke"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="EngStroke" Style="{StaticResource Field}"
                                   TextChanged="OnEngineChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" x:Name="EngStrokeNote"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Cylinders"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="EngCylinders" Style="{StaticResource Field}"
                                   TextChanged="OnEngineChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" x:Name="EngShapeNote"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Engine speed"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="EngRpm" Style="{StaticResource Field}"
                                   TextChanged="OnEngineChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="rpm — the limit you actually use"/>

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Displacement"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="EngLitres"
                                   Style="{StaticResource Answer}" FontSize="19" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}" x:Name="EngLitresNote"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="One cylinder"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="EngCylinderCc"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}" Text="cc swept"/>

                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Mean piston speed"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="EngPistonSpeed"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}" x:Name="EngPistonNote"/>

                        <TextBlock Grid.Row="9" Style="{StaticResource Label}" Text="Chamber volume"/>
                        <TextBox   Grid.Row="9" Grid.Column="1" x:Name="EngChamber" Style="{StaticResource Field}"
                                   TextChanged="OnEngineChanged"/>
                        <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="cc in the head"/>

                        <TextBlock Grid.Row="10" Style="{StaticResource Label}" Text="Gasket"/>
                        <TextBox   Grid.Row="10" Grid.Column="1" x:Name="EngGasket" Style="{StaticResource Field}"
                                   TextChanged="OnEngineChanged"/>
                        <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource Unit}" x:Name="EngGasketNote"/>

                        <TextBlock Grid.Row="11" Style="{StaticResource Label}" Text="Deck clearance"/>
                        <TextBox   Grid.Row="11" Grid.Column="1" x:Name="EngDeck" Style="{StaticResource Field}"
                                   TextChanged="OnEngineChanged"/>
                        <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="mm below the deck at TDC — negative if it pokes out"/>

                        <TextBlock Grid.Row="12" Style="{StaticResource Label}" Text="Piston crown"/>
                        <TextBox   Grid.Row="12" Grid.Column="1" x:Name="EngPiston" Style="{StaticResource Field}"
                                   TextChanged="OnEngineChanged"/>
                        <TextBlock Grid.Row="12" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="cc — a dish is positive, a dome negative"/>

                        <TextBlock Grid.Row="14" Style="{StaticResource Label}" Text="Compression ratio"/>
                        <TextBlock Grid.Row="14" Grid.Column="1" x:Name="EngRatio"
                                   Style="{StaticResource Answer}" FontSize="19" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="14" Grid.Column="2" Style="{StaticResource Unit}" x:Name="EngRatioNote"/>

                        <TextBlock Grid.Row="15" Style="{StaticResource Label}" Text="With your boost"/>
                        <TextBlock Grid.Row="15" Grid.Column="1" x:Name="EngBoosted"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="15" Grid.Column="2" Style="{StaticResource Unit}" x:Name="EngBoostedNote"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Note}"
                               Text="Mean piston speed says more about what an engine is being asked to survive than its rpm does. Seven thousand is an easy afternoon for a short stroke and the end of the road for a long one — the rings and the rod feel the distance, not the number on the tachometer. And it is a mean: the piston stops dead twice a revolution and passes through about 1.6 times this in the middle."/>

                    <TextBlock Style="{StaticResource Note}"
                               Text="The compression ratio here is the static one, which is geometry and nothing else. A long-duration cam holds the inlet open past bottom dead centre and pushes some of the charge back out, so the engine behaves like less than this down low and comes back to it as the ports start to fill."/>

                    <TextBlock Style="{StaticResource Note}" x:Name="EngNote"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== turbo sizing ===== -->
            <ScrollViewer x:Name="PageTurbo" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="The sizing worked backwards: from the power you want to the air it takes, the boost that needs, and the turbochargers that could do it."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/>
                            <RowDefinition Height="14"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Target power"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TurboPower" Style="{StaticResource Field}"
                                   TextChanged="OnTurboChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="hp at the crank"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Displacement"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TurboLitres" Style="{StaticResource Field}"
                                   TextChanged="OnTurboChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" x:Name="TurboLitresNote"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Peak-power speed"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TurboRpm" Style="{StaticResource Field}"
                                   TextChanged="OnTurboChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="rpm — where the target is made"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Head and cams"/>
                        <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="TurboVeFamily" Width="150" Margin="0,2"
                                   HorizontalAlignment="Left" SelectionChanged="OnTurboVeFamilyChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}" x:Name="TurboVeNote"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Volumetric efficiency"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TurboVe" Style="{StaticResource Field}"
                                   TextChanged="OnTurboChanged"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="% at the power peak"/>

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Fuel"/>
                        <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="TurboFuel" Width="150" Margin="0,2"
                                   HorizontalAlignment="Left" SelectionChanged="OnTurboFuelChanged"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}" x:Name="TurboFuelNote"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Air-fuel ratio"/>
                        <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TurboAfr" Style="{StaticResource Field}"
                                   TextChanged="OnTurboChanged"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}" x:Name="TurboAfrNote"/>

                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="BSFC"/>
                        <TextBox   Grid.Row="7" Grid.Column="1" x:Name="TurboBsfc" Style="{StaticResource Field}"
                                   TextChanged="OnTurboChanged"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}" x:Name="TurboBsfcNote"/>

                        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Charge temperature"/>
                        <TextBox   Grid.Row="8" Grid.Column="1" x:Name="TurboChargeTemp" Style="{StaticResource Field}"
                                   TextChanged="OnTurboChanged"/>
                        <StackPanel Grid.Row="8" Grid.Column="2" Orientation="Horizontal">
                            <ComboBox x:Name="TurboTempUnit" Width="62" Margin="8,2,0,2"
                                      SelectionChanged="OnTurboTempUnitChanged"/>
                            <TextBlock Style="{StaticResource Unit}" x:Name="TurboTempNote"/>
                        </StackPanel>

                        <TextBlock Grid.Row="9" Style="{StaticResource Label}" Text="Losses"/>
                        <TextBox   Grid.Row="9" Grid.Column="1" x:Name="TurboInletLoss" Style="{StaticResource Field}"
                                   TextChanged="OnTurboChanged"/>
                        <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="psi through the filter (intercooler: Pressure ratio tab)"/>

                        <TextBlock Grid.Row="11" Style="{StaticResource Label}" Text="Air needed"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" x:Name="TurboAir"
                                   Style="{StaticResource Answer}" FontSize="19" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="lb/min — what a compressor map is read in"/>

                        <TextBlock Grid.Row="12" Style="{StaticResource Label}" Text="Boost needed"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" x:Name="TurboBoost"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="12" Grid.Column="2" Style="{StaticResource Unit}" x:Name="TurboBoostNote"/>

                        <TextBlock Grid.Row="13" Style="{StaticResource Label}" Text="Pressure ratio"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" x:Name="TurboRatio"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="13" Grid.Column="2" Style="{StaticResource Unit}" x:Name="TurboRatioNote"/>

                        <TextBlock Grid.Row="14" Style="{StaticResource Label}" Text="Headroom wanted"/>
                        <TextBox   Grid.Row="14" Grid.Column="1" x:Name="TurboHeadroom" Style="{StaticResource Field}"
                                   TextChanged="OnTurboChanged"/>
                        <TextBlock Grid.Row="14" Grid.Column="2" Style="{StaticResource Unit}"
                                   Text="% of flow spare, over what is needed"/>
                    </Grid>

                    <Border Margin="0,14,0,0" Padding="12,8" CornerRadius="5"
                            Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="TurboPicksTitle"
                                       Foreground="{DynamicResource Text}" FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="TurboPicks" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Note}" x:Name="TurboNote"/>

                    <TextBlock Style="{StaticResource Note}"
                               Text="The smallest that can pass the air is listed first, because it is the one that will spool soonest and spend most of its life near the middle of its map rather than off the left edge of it. Anything below it in the list flows more and lags more."/>

                    <TextBlock Style="{StaticResource Note}"
                               Text="This is not a compressor map. A turbocharger that flows enough may still be wrong — choked at low speed, past the edge of its island at the ratio wanted, or simply too large to spool on the engine. Flow and pressure ratio narrow the field to the ones worth looking at; the map decides between them, and there is no substitute for reading one."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== the strip ===== -->
            <!--
                Running costs.

                Laid out in columns rather than as three stacked forms, because
                the question is a comparison and a comparison you have to scroll
                between is not one. Every row is the same field for all three
                cars, so the eye runs across it.
            -->
            <ScrollViewer x:Name="PageIntercooler" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="14">
                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="How much heat there is to move, what a core will actually take out of it, and what spraying something into the charge does instead."/>

                    <TextBlock Style="{StaticResource Heading}" Text="THE CHARGE"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="12"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Airflow"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="IcAir" Style="{StaticResource Field}"
                                   TextChanged="OnIcChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcAirNote"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Boost"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="IcBoost" Style="{StaticResource Field}"
                                   TextChanged="OnIcChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcBoostNote"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Ambient air"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="IcAmbient" Style="{StaticResource Field}"
                                   TextChanged="OnIcChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" Text="°F drawn into the compressor"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Compressor efficiency"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="IcCompEff" Style="{StaticResource Field}"
                                   TextChanged="OnIcChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}" Text="% — 70 is ordinary, 78 is a good match"/>

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Out of the compressor"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="IcHotSide"
                                   Style="{StaticResource Answer}" FontSize="19" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcHotSideNote"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Heat to move"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="IcHeat"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcHeatNote"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Heading}" Text="THE CORE"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="12"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Effectiveness"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="IcEffect" Style="{StaticResource Field}"
                                   TextChanged="OnIcChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="% of the available drop the core takes — about 70 for a good air-to-air"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Core, W × H × thick"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="IcW" Width="42" Margin="0,2,3,2" HorizontalContentAlignment="Right"
                                     TextChanged="OnIcChanged" GotKeyboardFocus="OnFieldFocused"
                                     PreviewMouseLeftButtonDown="OnFieldClicked"/>
                            <TextBox x:Name="IcH" Width="42" Margin="0,2,3,2" HorizontalContentAlignment="Right"
                                     TextChanged="OnIcChanged" GotKeyboardFocus="OnFieldFocused"
                                     PreviewMouseLeftButtonDown="OnFieldClicked"/>
                            <TextBox x:Name="IcT" Width="42" Margin="0,2" HorizontalContentAlignment="Right"
                                     TextChanged="OnIcChanged" GotKeyboardFocus="OnFieldFocused"
                                     PreviewMouseLeftButtonDown="OnFieldClicked"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcCoreNote"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Material"/>
                        <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="IcMaterial" Width="150" Margin="0,2"
                                   HorizontalAlignment="Left" SelectionChanged="OnIcMaterialChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcMaterialNote"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Charge after the core"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="IcOut"
                                   Style="{StaticResource Answer}" FontSize="19" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcOutNote"/>

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Density gained"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="IcDensity"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcDensityNote"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Core loading"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="IcLoading"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcLoadingNote"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Note}" x:Name="IcCoreAdvice"/>

                    <TextBlock Style="{StaticResource Heading}" Text="CHEMICAL INTERCOOLING — SPRAYING INTO THE CHARGE"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition Height="12"/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Fluid"/>
                        <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="IcFluid" Width="180" Margin="0,2"
                                   HorizontalAlignment="Left" SelectionChanged="OnIcFluidChanged"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcFluidNote"/>

                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Drop wanted"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="IcDrop" Style="{StaticResource Field}"
                                   TextChanged="OnIcChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcDropNote"/>

                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Evaporates in the charge"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="IcEvap" Style="{StaticResource Field}"
                                   TextChanged="OnIcChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" Text="% — the rest wets the pipe or evaporates in the cylinder"/>

                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Fuel flow at this airflow"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="IcFuel" Style="{StaticResource Field}"
                                   TextChanged="OnIcChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}" Text="lb/min, so the spray can be given as a share of it"/>

                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Nozzle needed"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="IcNozzle"
                                   Style="{StaticResource Answer}" FontSize="19" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcNozzleNote"/>

                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="As a mass flow"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="IcSprayLb"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcSprayLbNote"/>

                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Consumption"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="IcConsumption"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcConsumptionNote"/>

                        <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Petrol it displaces"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="IcDisplaced"
                                   Style="{StaticResource Answer}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource Unit}" x:Name="IcDisplacedNote"/>

