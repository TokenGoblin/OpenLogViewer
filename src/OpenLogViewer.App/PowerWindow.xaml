<Window x:Class="OpenLogViewer.App.PowerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estimate power"
        Height="720" Width="700"
        MinHeight="460" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        ShowInTaskbar="False">

    <Window.Resources>
        <!--
            Every numeric field selects itself when it takes focus, so typing
            replaces the number rather than joining onto it. These boxes hold
            working values rather than placeholders — the window computes as you
            type — so emptying them on focus would leave a page of dashes, and
            ghost text would mean nothing to read until eight boxes were filled.
            A second click still places the caret for editing one digit.
        -->
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,2"/>
            <EventSetter Event="GotKeyboardFocus" Handler="OnFieldFocused"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnFieldClicked"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource Bg}">
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Width="80" Click="OnCloseClick"/>
                <Button DockPanel.Dock="Right" x:Name="AddButton" Content="Add channels"
                        Width="110" Margin="0,0,8,0" Click="OnAddClick"/>
                <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Style="{StaticResource Note}" Margin="0,0,0,4" TextWrapping="Wrap"
                           Text="Two independent estimates from what the log already holds. Speed density works the air out from the manifold; the injector route ignores the air and counts the fuel instead. Where they agree the figure is worth believing — where they do not, the disagreement is the useful part."/>

                <TextBlock Style="{StaticResource Heading}" Text="THE ENGINE"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Displacement"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="Litres" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="litres"/>

                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Cylinders"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="Cylinders" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="one injector each"/>

                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Fuel"/>
                    <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="FuelBox" Width="150" Margin="0,2"
                               HorizontalAlignment="Left" SelectionChanged="OnFuelChanged"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" x:Name="FuelNote"/>

                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="BSFC"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="Bsfc" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}" x:Name="BsfcNote"/>

                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Volumetric efficiency"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="Ve" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}" x:Name="VeNote"/>

                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Driveline loss"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" x:Name="Loss" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}"
                               Text="% — zero leaves the figure at the crank"/>
                </Grid>

                <TextBlock Style="{StaticResource Heading}" Text="THE INJECTORS"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Injector flow"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="InjectorCc" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Unit}" Text="cc/min, each"/>

                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Rated at"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="RatedKpa" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}"
                               Text="kPa across the injector — 300 is three bar"/>

                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Dead time"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="DeadTime" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" x:Name="DeadTimeNote"/>

                    <CheckBox Grid.Row="3" Grid.ColumnSpan="3" x:Name="Batch" Margin="0,6,0,0"
                              Foreground="{DynamicResource Text}" Click="OnToggled"
                              Content="Batch injection — fires twice a cycle rather than once"/>

                    <CheckBox Grid.Row="4" Grid.ColumnSpan="3" x:Name="Differential" Margin="0,4,0,0"
                              Foreground="{DynamicResource Text}" Click="OnToggled"
                              Content="Logged fuel pressure is already the difference across the injector"/>
                </Grid>

                <TextBlock Style="{StaticResource Heading}" Text="WHAT THIS LOG CAN DO"/>

                <Border Padding="12,8" CornerRadius="5"
                        Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="Available" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="Missing" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Note}"
                           Text="None of this is a dyno. Every method multiplies by a brake specific fuel consumption that has been assumed rather than measured, so the absolute number carries that assumption's error — ten per cent, easily. What they are good for is shape and change: where the power is made, what a modification did, whether two runs match. Those are ratios, and the assumption divides out of a ratio."/>

                <TextBlock Style="{StaticResource Note}" x:Name="Advice"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
