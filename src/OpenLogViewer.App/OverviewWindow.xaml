<Window x:Class="OpenLogViewer.App.OverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenLogViewer.App"
        Title="Overview" Height="720" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}">

    <DockPanel>
        <!--
            What a connected AI agent concluded, said before the findings — same
            reasoning as Insights: a reader who cannot see the headline has no way to
            weigh the detail underneath it.
        -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10"
                               Foreground="{DynamicResource Muted}"
                               Text="{Binding OverviewRevision, StringFormat='Revision {0}'}"
                               Visibility="{Binding HasOverview, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding OverviewHeadline}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="{Binding OverviewSummary}" FontSize="12" Margin="0,6,0,0"
                           Foreground="{DynamicResource Text}" TextWrapping="Wrap" LineHeight="17"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Copy selected" Padding="12,4" Margin="0,0,8,0"
                        Click="OnCopySelectedClick"
                        ToolTip="Puts the accepted changes on the clipboard, ready to paste back to the agent"/>
                <Button DockPanel.Dock="Left" Content="Clear" Click="OnClearClick" Padding="12,4"
                        ToolTip="Discards this overview"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Muted}"
                           Text="{Binding Tally, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </DockPanel>
        </Border>

        <Grid>
            <TextBlock Text="No AI overview has been generated yet. Ask your connected AI agent to review the open tune and log."
                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource Muted}" Margin="40"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="{Binding NoOverview, Converter={StaticResource BoolToVis}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12"
                          Visibility="{Binding HasOverview, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding OverviewFindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="4"
                                    Background="{DynamicResource PanelAlt}"
                                    BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Badge}"
                                                   FontSize="10" FontWeight="Bold" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Accent}"/>
                                        <TextBlock Text="{Binding Topic}" FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,5,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text}"/>

                                    <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,4,0,0"
                                               TextWrapping="Wrap" LineHeight="18"
                                               Foreground="{DynamicResource Text}"/>

                                    <!-- The arithmetic, so the conclusion can be argued with. -->
                                    <TextBlock Text="{Binding Evidence}" FontSize="10" Margin="0,6,0,0"
                                               TextWrapping="Wrap" FontFamily="Consolas"
                                               Foreground="{DynamicResource Muted}"
                                               Visibility="{Binding HasEvidence,
                                                            Converter={StaticResource BoolToVis}}"/>

                                    <!-- The only editable thing in this window: whether to apply it. -->
                                    <CheckBox Content="{Binding Change.Description}"
                                              IsChecked="{Binding Accepted}"
                                              Margin="0,8,0,0" FontSize="12"
                                              Foreground="{DynamicResource Text}"
                                              Visibility="{Binding HasChange,
                                                           Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
