<Window x:Class="OpenLogViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenLogViewer.App"
        Title="{Binding Title}"
        Icon="AppIcon.ico"
        Height="760" Width="1280"
        MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver">

    <DockPanel>

        <!--
            The menu.

            Every command lives here, and this is the only part of the window
            that can grow without pushing something else off the edge — which is
            what the single toolbar had started doing, trimming its own buttons
            to "R…" and "T…". Anything added later goes in a menu; the toolbar
            below is for the few things reached constantly.
        -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="6,1">
            <MenuItem Header="_File">
                <MenuItem Header="_Open log…" Click="OnOpenClick" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Open _tune…" Click="OnOpenTuneClick"
                          ToolTip="Use tables from a .msq file instead of the one stored in the log"/>
                <MenuItem Header="Compare against another log…" Click="OnCompareClick"
                          IsEnabled="{Binding HasDocument}"
                          ToolTip="Open a second log and show what changed between them"/>
                <MenuItem Header="Stop comparing" Click="OnStopCompareClick"
                          IsEnabled="{Binding HasComparison}"/>
                <MenuItem Header="Show the difference" IsCheckable="True"
                          IsChecked="{Binding ShowDifference}"
                          IsEnabled="{Binding HasComparison}"
                          ToolTip="Subtract the second log's table from this one, cell by cell"/>
                <Separator/>
                <MenuItem Header="Use the tune stored in the log" Click="OnClearTuneClick"
                          IsEnabled="{Binding UsingLoadedTune}"/>
                <Separator/>
                <MenuItem Header="_Export" IsEnabled="{Binding CanExport}">
                    <MenuItem Header="Plotted channels as CSV…" Click="OnExportPlottedCsvClick"
                              IsEnabled="{Binding CanExportPlotted}"
                              Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="All channels as CSV…" Click="OnExportAllCsvClick"
                              Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="Plot as PNG…" Click="OnExportPlotPngClick"
                              Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="Table as CSV…" Click="OnExportTableCsvClick"
                              Visibility="{Binding ShowHistogram, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="Sample counts as CSV…" Click="OnExportCountsCsvClick"
                              Visibility="{Binding ShowHistogram, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="Table as PNG…" Click="OnExportTablePngClick"
                              Visibility="{Binding ShowHistogram, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="Plotted points as CSV…" Click="OnExportPointsCsvClick"
                              Visibility="{Binding ShowScatter, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="Scatter as PNG…" Click="OnExportScatterPngClick"
                              Visibility="{Binding ShowScatter, Converter={StaticResource BoolToVis}}"/>
                    <Separator Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="{Binding ExportScope, StringFormat=CSV covers the {0}}"
                              IsEnabled="False"
                              Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}"/>
                </MenuItem>
                <MenuItem Header="_Data folder">
                    <MenuItem Header="Open the folder" Click="OnOpenDataFolderClick"/>
                    <MenuItem Header="Change the folder…" Click="OnChangeDataFolderClick"
                              ToolTip="Where recordings and exports are kept"/>
                    <Separator/>
                    <MenuItem Header="{Binding DataFolder}" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Log" IsCheckable="True" IsChecked="{Binding InLogMode}"
                          ToolTip="Recordings: the plot and the heat table"/>
                <MenuItem Header="_Gauges" IsCheckable="True" IsChecked="{Binding InGaugeMode}"
                          ToolTip="Live dials, as the firmware defines them"/>
                <MenuItem Header="_Calibration" IsCheckable="True" IsChecked="{Binding InCalibrationMode}"
                          ToolTip="Work on the tune itself"/>
                <MenuItem Header="G_uide" IsCheckable="True" IsChecked="{Binding InGuideMode}"
                          ToolTip="How to use this application"/>
                <Separator/>
                <MenuItem Header="_Plot" IsCheckable="True" IsChecked="{Binding ShowLog}"
                          IsEnabled="{Binding InLogMode}" ToolTip="Time-series view"/>
                <MenuItem Header="_Histogram" IsCheckable="True" IsChecked="{Binding ShowHistogram}"
                          IsEnabled="{Binding InLogMode}"
                          ToolTip="Bin the log into a table, like a tuning table"/>
                <MenuItem Header="Sc_atter" IsCheckable="True" IsChecked="{Binding ShowScatter}"
                          IsEnabled="{Binding InLogMode}"
                          ToolTip="Every sample at its own X and Y, coloured by a third channel"/>
                <Separator/>
                <MenuItem Header="_Overlaid traces" IsCheckable="True" IsChecked="{Binding OverlaidLanes}"
                          IsEnabled="{Binding ShowLog}"
                          ToolTip="All traces share the plot — best for comparing timing between channels"/>
                <MenuItem Header="_Stacked traces" IsCheckable="True" IsChecked="{Binding StackedLanes}"
                          IsEnabled="{Binding ShowLog}"
                          ToolTip="Each channel gets its own strip — best when several are plotted"/>
                <Separator/>
                <MenuItem Header="_Find in the log…" Click="OnFindMenuClick"
                          IsEnabled="{Binding ShowLog}" InputGestureText="Ctrl+F"
                          ToolTip="Jump to where a condition held — RPM &gt; 4000 &amp;&amp; TPS &gt; 80"/>
                <MenuItem Header="_Reset zoom" Click="OnResetZoomClick" IsEnabled="{Binding ShowLog}"/>
                <MenuItem x:Name="HoldSteadyItem" Header="Draw steady channels as steady"
                          IsCheckable="True" IsChecked="True" Click="OnHoldSteadyClick"
                          ToolTip="A sensor that barely moves is drawn flat rather than having its last decimal stretched to fill the lane. Turn off to see the true range"/>
                <Separator/>
                <MenuItem x:Name="UnitsMenuItem" Header="_Units" SubmenuOpened="OnUnitsMenuOpened">
                    <MenuItem Header="…" IsEnabled="False"/>
                </MenuItem>
                <MenuItem x:Name="ThemeMenuItem" Header="_Theme" SubmenuOpened="OnThemeMenuOpened">
                    <MenuItem Header="…" IsEnabled="False"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Tools">
                <!-- Filled when it opens: an adapter can appear or vanish while
                     the application is running. -->
                <MenuItem x:Name="ConnectMenuItem" Header="_Connect" SubmenuOpened="OnConnectMenuOpened">
                    <MenuItem Header="…" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="{Binding ReconnectLabel}" Click="OnReconnectClick"
                          IsEnabled="{Binding CanReconnect}" InputGestureText="Ctrl+K"
                          ToolTip="Reconnect to the ECU you used last"/>
                <MenuItem Header="_Disconnect" Click="OnDisconnectClick" IsEnabled="{Binding IsLive}"/>
                <MenuItem Header="_Forget remembered ECUs" Click="OnForgetEcusClick"
                          ToolTip="Clears the list of devices this has connected to. Presets, filters and calculated channels are untouched"/>
                <MenuItem Header="_Fault codes…" Click="OnFaultsClick"
                          IsEnabled="{Binding IsObd2Live}"
                          ToolTip="Read and clear the vehicle's trouble codes — OBD2 only"/>
                <Separator/>
                <MenuItem Header="{Binding RecordLabel}" Click="OnRecordClick"
                          IsEnabled="{Binding CanRecord}"
                          ToolTip="Choose when a log starts, what it is called and where it goes"/>
                <MenuItem Header="Record as soon as I _connect" IsCheckable="True"
                          IsChecked="{Binding RecordOnConnect}"
                          ToolTip="On by default. Turn it off to pick the moment a log starts yourself — the session is still watched and plotted either way"/>
                <MenuItem Header="Open the _recordings folder" Click="OnOpenRecordingsClick"/>
                <Separator/>
                <MenuItem x:Name="RateMenuItem" Header="Logging _rate" SubmenuOpened="OnRateMenuOpened">
                    <MenuItem Header="…" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="Read the block in one request" IsCheckable="True"
                          IsChecked="{Binding SingleRequestBlock}"
                          ToolTip="Faster where the firmware allows it, fatal where it does not"/>
                <Separator/>
                <MenuItem Header="_Save the tune to a file…" Click="OnSaveTuneFileClick"
                          IsEnabled="{Binding CanSaveTune}"
                          ToolTip="Write every setting to a .msq — a backup, and the format TunerStudio reads"/>
                <MenuItem Header="_Open a saved tune…" Click="OnOpenSavedTuneClick"
                          ToolTip="Open a .msq and its firmware's settings pages, with no ECU attached"/>
                <MenuItem Header="Co_mpare with a saved tune…" Click="OnCompareTuneClick"
                          IsEnabled="{Binding HasEcuTune}"
                          ToolTip="Says which settings the file and the tune in hand disagree about"/>
                <MenuItem Header="_Restore a saved tune to the ECU…" Click="OnRestoreTuneClick"
                          IsEnabled="{Binding CanBurn}"
                          ToolTip="Writes the settings that differ, leaving alone everything the file does not mention"/>
                <Separator/>
                <MenuItem Header="_ECU definition files…" Click="OnDefinitionsClick"
                          ToolTip="Where to put the .ini for an ECU this machine does not already know"/>
                <Separator/>
                <MenuItem Header="Ca_lculators…" Click="OnCalculatorsClick"
                          ToolTip="Boost, pressure ratio, injectors, fuel pump, lambda, octane, engine, gearing and airflow"/>
                <MenuItem Header="Estimate _power…" Click="OnEstimatePowerClick"
                          IsEnabled="{Binding HasDocument}"
                          ToolTip="Calculated channels that estimate horsepower from the log"/>
                <Separator/>

                <!--
                    Off until it is asked for, because it opens a socket. The two
                    entries are deliberately apart: starting the API lets an
                    agent read, which is harmless, while arming writes is the
                    separate decision that lets one change the engine.
                -->
                <MenuItem Header="Tuning _project…" Click="OnProjectClick"
                          ToolTip="What is wrong with this tune, what has been tried, and whether it worked"/>
                <Separator/>

                <MenuItem Header="_Agent API…" Click="OnAgentApiClick"
                          ToolTip="A local API an AI assistant or a script can watch this session through"/>
                <MenuItem Header="Allow agent _writes"
                          IsCheckable="True"
                          IsChecked="{Binding AgentWritesArmed, Mode=TwoWay}"
                          IsEnabled="{Binding AgentIsRunning}"
                          ToolTip="Lets an agent change settings in the ECU's working memory. It never burns, and this clears itself on disconnect"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="How to use _this app" Click="OnGuideClick"
                          ToolTip="The guide, carried inside the application"/>
                <Separator/>
                <MenuItem Header="_Documentation online" Click="OnDocumentationClick"/>
                <Separator/>
                <MenuItem Header="_About OpenLogViewer" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!--
            The toolbar: only what is reached constantly.

            Everything here is also in a menu. It earns its place by being one
            click rather than two, not by being the only way to get at it — which
            is what stops this row growing again.
        -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <!--
                    Declared first, and docked right.

                    A DockPanel hands out space in the order its children are
                    declared, so this being first is what guarantees it gets its
                    width — put after the chips on the left, it would be the thing
                    squeezed at a narrow window, which is precisely how the old
                    toolbar came to show "R…" and "T…".

                    What gives way instead is the status text, which is the last
                    child and trims itself, and below about a thousand pixels the
                    trailing view chips — both of which are also in the View menu.

                    It earns the place by the same rule as the rest: reached
                    constantly, and one click rather than two.
                -->
                <Button DockPanel.Dock="Right" Content="ƒ  Calculators"
                        Click="OnCalculatorsClick" Padding="10,3"
                        ToolTip="Plan a build, size a turbo, injectors, fuel pump, octane, gearing — none of it needs a log open"/>

                <!--
                    Beside the calculators, and for the opposite reason: those
                    work out what an engine should do, this measures what one
                    actually did.
                -->
                <Button DockPanel.Dock="Right" Content="◈  Insights"
                        Click="OnInsightsClick" Padding="10,3" Margin="0,0,8,0"
                        IsEnabled="{Binding HasDocument}"
                        ToolTip="What this log says about the engine: mixture against target, injector headroom, knock, idle steadiness and more — with the arithmetic behind each"/>

                <Button Content="Open log…" Click="OnOpenClick" DockPanel.Dock="Left"/>

                <!--
                    Beside Open log, so it is obvious that both can be opened.

                    It was moved out of here when the toolbar had thirteen
                    controls in it and was trimming its own buttons to "R…", and
                    it went to the histogram sidebar next to Axis breakpoints —
                    which is where it is wanted once you are already binning a log
                    against a tune, and invisible from the Log view you actually
                    land in. Somebody went looking for it and could not find it,
                    which is the only test of discoverability that counts.

                    Docked left and early so it keeps its width; what gives way at
                    a narrow window is the status text, which is last.
                -->
                <Button Content="Open tune…" Click="OnOpenTuneClick" Margin="6,0,0,0"
                        DockPanel.Dock="Left"
                        ToolTip="Use tables from a .msq file instead of the one stored in the log">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Use the tune stored in the log" Click="OnClearTuneClick"
                                      IsEnabled="{Binding UsingLoadedTune}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!--
                    The ECU you were on last, as one click.

                    Named after the ECU rather than the port: the COM number is
                    Windows' business and moves with the order things were plugged
                    in, while what somebody remembers is that they were on the
                    Speeduino. Hidden entirely when nothing has been connected to
                    yet, so a new install shows the plain Connect button and no
                    dead shortcut.

                    Deliberately not automatic. Launching the application must not
                    take a serial port on its own — a laptop opened in a car with
                    TunerStudio already talking to the ECU would fight it for the
                    port, and somebody who only wanted to look at a saved log would
                    have started a session they never asked for.
                -->
                <Button x:Name="ReconnectButton" Content="{Binding ReconnectLabel}"
                        Click="OnReconnectClick" Margin="6,0,0,0" DockPanel.Dock="Left"
                        Visibility="{Binding CanReconnect, Converter={StaticResource BoolToVis}}"
                        ToolTip="Reconnect to the ECU you used last  (Ctrl+K)"/>

                <Button x:Name="ConnectButton" Content="Connect ▾" Click="OnConnectClick"
                        Margin="6,0,0,0" DockPanel.Dock="Left"
                        ToolTip="Read live data from an ECU over serial or Bluetooth">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="PortsMenu"/>
                    </Button.ContextMenu>
                </Button>

                <!--
                    Only while connected, and next to Connect because that is
                    what it belongs to. Docked early so it keeps its width — the
                    label changes between "Record…" and "Stop recording", and a
                    button that trims to "Stop rec…" mid-session is exactly the
                    thing worth not doing on the one control that says whether a
                    file is being written.
                -->
                <Button x:Name="RecordButton" Content="{Binding RecordLabel}"
                        Click="OnRecordClick" Margin="6,0,0,0" DockPanel.Dock="Left"
                        Visibility="{Binding CanRecord, Converter={StaticResource BoolToVis}}"
                        ToolTip="Start or stop writing the live session to a file of your choosing">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <!-- Coloured only while it is actually writing, so
                                     the state is readable without reading. -->
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Marker}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Rectangle DockPanel.Dock="Left" Width="1" Margin="12,2" VerticalAlignment="Stretch"
                           Fill="{DynamicResource Line}"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Chip}" Content="Log" GroupName="Mode"
                                 IsChecked="{Binding InLogMode}" ToolTip="Recordings: the plot and the heat table"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Gauges" GroupName="Mode"
                                 IsChecked="{Binding InGaugeMode}"
                                 ToolTip="Live dials, as the firmware defines them"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Calibration" GroupName="Mode"
                                 IsChecked="{Binding InCalibrationMode}"
                                 ToolTip="Work on the tune itself"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Guide" GroupName="Mode"
                                 IsChecked="{Binding InGuideMode}"
                                 ToolTip="How to use this application"/>
                </StackPanel>

                <Rectangle DockPanel.Dock="Left" Width="1" Margin="12,2" VerticalAlignment="Stretch"
                           Fill="{DynamicResource Line}"
                           Visibility="{Binding InLogMode, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Visibility="{Binding InLogMode, Converter={StaticResource BoolToVis}}">
                    <RadioButton Style="{StaticResource Chip}" Content="Log" GroupName="LogView"
                                 IsChecked="{Binding ShowLog}" ToolTip="Time-series view"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Histogram" GroupName="LogView"
                                 IsChecked="{Binding ShowHistogram}"
                                 ToolTip="Bin the log into a table, like a tuning table"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Scatter" GroupName="LogView"
                                 IsChecked="{Binding ShowScatter}"
                                 ToolTip="Every sample at its own X and Y, coloured by a third channel"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}">
                    <RadioButton Style="{StaticResource Chip}" Content="Overlaid"
                                 IsChecked="{Binding OverlaidLanes}"
                                 ToolTip="All traces share the plot — best for comparing timing between channels"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Stacked"
                                 IsChecked="{Binding StackedLanes}"
                                 ToolTip="Each channel gets its own strip — best when several are plotted"/>
                </StackPanel>

                <!-- The flexible middle, which gives way to everything else. -->
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           Margin="16,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Status}"
                           Foreground="{DynamicResource Muted}"/>
            </DockPanel>
        </Border>

        <!--
            The status bar.

            Where readouts belong, and where they were not: the live indicator,
            the cursor time and which tune is loaded were all competing for
            toolbar space with the buttons. None of them is a command, and a
            toolbar is for commands.
        -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                           Margin="0,0,14,0" MaxWidth="320" TextTrimming="CharacterEllipsis"
                           Text="{Binding LiveStatus}" ToolTip="{Binding LiveDetail}"
                           Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LiveHealthy}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Marker}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Labelled rather than bare: "from the log" on its own does not
                     say what it is describing. -->
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                           Margin="14,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis"
                           Text="{Binding TuneSource, StringFormat=Tune: {0}}"
                           ToolTip="{Binding TuneDetail}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UsingLoadedTune}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                                <!-- Last, so it wins: a tune that does not match
                                     the log is the one case that must catch the
                                     eye, and it is also a loaded one. -->
                                <DataTrigger Binding="{Binding HasTuneWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Marker}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding CursorTime}" DockPanel.Dock="Right"
                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource Accent}" Margin="14,0,0,0"/>

                <TextBlock Foreground="{DynamicResource Muted}" FontSize="11"
                           VerticalAlignment="Center"
                           Text="{Binding Hint}" ToolTip="{Binding Hint}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid>

        <!-- Log mode: the plot and the heat table over a recording. -->
        <Grid Visibility="{Binding InLogMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Channel sidebar -->
            <!-- Axis settings replace the channel list in table and scatter modes.
                 Both are the same three channels through the same filters, so they
                 are chosen in one place; only what becomes of the samples differs. -->
            <Border Grid.Column="0" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"
                    Visibility="{Binding ShowAxisPanel, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,10,12,12">
                    <TextBlock Text="AXIS FIELDS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>

                    <TextBlock Text="X axis" FontSize="11" Foreground="{DynamicResource Muted}"/>
                    <ComboBox ItemsSource="{Binding AxisChannels}" SelectedItem="{Binding XAxis}"
                              ItemTemplate="{StaticResource ChannelName}" Margin="0,2,0,7"/>

                    <TextBlock Text="Y axis" FontSize="11" Foreground="{DynamicResource Muted}"/>
                    <ComboBox ItemsSource="{Binding AxisChannels}" SelectedItem="{Binding YAxis}"
                              ItemTemplate="{StaticResource ChannelName}" Margin="0,2,0,7"/>

                    <TextBlock Text="{Binding ZAxisCaption}" FontSize="11"
                               Foreground="{DynamicResource Muted}"/>
                    <ComboBox ItemsSource="{Binding AxisChannels}" SelectedItem="{Binding ZAxis}"
                              ItemTemplate="{StaticResource ChannelName}" Margin="0,2,0,7"/>

                    <TextBlock Text="Compare against — shows the difference" FontSize="11"
                               Foreground="{DynamicResource Muted}"/>
                    <ComboBox ItemsSource="{Binding CompareOptions}" SelectedItem="{Binding ZCompare}"
                              ItemTemplate="{StaticResource AxisSourceName}" Margin="0,2,0,12"
                              ToolTip="Subtract a target channel, so each cell shows how far off it is rather than what it read"/>

                    <!-- Only the table does anything with these. A scatter has no
                         cells to reduce, no size to choose, and nothing to bin onto
                         the tune's breakpoints — it draws the samples where they
                         fell. Hidden rather than disabled: a control that could
                         never apply here is noise, not a hint. -->
                    <StackPanel Visibility="{Binding ShowHistogram, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="CELL VALUE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Style="{StaticResource Chip}" Content="Mean" IsChecked="{Binding StatMean}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Min" IsChecked="{Binding StatMin}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Max" IsChecked="{Binding StatMax}"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Count" IsChecked="{Binding StatCount}"/>
                        </StackPanel>

                        <DockPanel Margin="0,0,0,2">
                            <Button DockPanel.Dock="Right" Content="Open tune…" Padding="7,2" FontSize="10"
                                    Click="OnOpenTuneClick"
                                    ToolTip="Use tables from a .msq file instead of the one stored in the log"/>
                            <TextBlock Text="AXIS BREAKPOINTS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="✕" Padding="5,0" FontSize="10"
                                    Click="OnClearTuneClick" ToolTip="Go back to the tune stored in the log"
                                    Visibility="{Binding UsingLoadedTune, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding TuneSource, StringFormat=Tune: {0}}" FontSize="10"
                                       Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <TextBlock Text="{Binding TuneWarning}" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Marker}" Margin="0,0,0,4"
                                   Visibility="{Binding HasTuneWarning, Converter={StaticResource BoolToVis}}"/>

                        <ComboBox ItemsSource="{Binding AxisSources}" SelectedItem="{Binding AxisSource}"
                                  ItemTemplate="{StaticResource AxisSourceName}" Margin="0,0,0,4"
                                  ToolTip="Bin onto the tune's own table axes, so cells line up with the table you are editing"/>
                        <TextBlock Text="No tune available, so bins come from the data. Open a .msq to use its tables."
                                   FontSize="10" Foreground="{DynamicResource Faint}" TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTuneAxes}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="TABLE SIZE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,5"
                                   Visibility="{Binding UsingDataAxes, Converter={StaticResource BoolToVis}}"/>
                        <Grid Margin="0,0,0,12"
                              Visibility="{Binding UsingDataAxes, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Columns" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                <TextBox Text="{Binding HistogramColumns, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                         Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Rows" FontSize="11" Foreground="{DynamicResource Muted}"/>
                                <TextBox Text="{Binding HistogramRows, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                         Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- VE Calibration. Only offered once the axis source carries the
                             tune's numbers, since it can only suggest a change to a
                             value it can read. -->
                        <TextBlock Text="VE CALIBRATION" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>

                        <CheckBox Content="Suggest a new fuel table" IsChecked="{Binding VeAnalyze}"
                                  IsEnabled="{Binding VeAvailable}" FontSize="11" Margin="0,0,0,4"
                                  ToolTip="Compare logged AFR against the target and scale the tune's cells to match"/>

                        <TextBlock Text="{Binding VeSummary}" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Faint}" Margin="0,0,0,5"
                                   Visibility="{Binding VeAnalyze, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Visibility="{Binding VeAnalyze, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,10">
                            <CheckBox Content="Show the new numbers" IsChecked="{Binding VeShowSuggested}"
                                      FontSize="11" Margin="0,0,0,5"
                                      ToolTip="Off shows how far each cell moves, as a percentage"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Min samples" FontSize="10"
                                               Foreground="{DynamicResource Faint}"/>
                                    <TextBox Text="{Binding VeMinimumSamples, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="A cell with fewer samples is left alone"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Max change %" FontSize="10"
                                               Foreground="{DynamicResource Faint}"/>
                                    <TextBox Text="{Binding VeMaxChange, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Largest move suggested for one pass"/>
                                </StackPanel>
                            </Grid>

                            <!-- The reading arrives after the event it describes.
                                 Nothing here can know by how much, since it depends
                                 on where the sensor is fitted, so it is asked for
                                 rather than assumed. -->
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Find it" Padding="7,2" FontSize="10"
                                        Click="OnFindDelayClick" VerticalAlignment="Bottom"
                                        ToolTip="Work the delay out from this log, by finding the one that makes the readings in each cell agree best"/>
                                <TextBlock Text="Wideband delay, s" FontSize="10"
                                           Foreground="{DynamicResource Faint}"
                                           VerticalAlignment="Bottom"/>
                            </DockPanel>
                            <TextBox Text="{Binding VeDelaySeconds, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="How long the sensor takes to see the mixture metered now. It depends on where it is fitted — 0.2 to 0.4 s is typical."/>
                            <TextBlock Text="{Binding VeDelayFinding}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}" Margin="0,3,0,0"
                                       Visibility="{Binding HasVeDelayFinding,
                                                    Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding VeDelayNote}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Faint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="DISPLAY" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
                    <CheckBox Content="Colour by sample count" IsChecked="{Binding ColorByCount}"
                              FontSize="11" Margin="0,0,0,5"
                              ToolTip="Shade cells by how much data backs them, rather than by value"/>
                    <CheckBox Content="Only the zoomed time range" IsChecked="{Binding HistogramZoomOnly}"
                              FontSize="11" Margin="0,0,0,12"
                              ToolTip="Build the table from the range zoomed to in the log view"/>

                    <DockPanel Margin="0,0,0,5">
                        <Button DockPanel.Dock="Right" Content="None" Padding="7,2" FontSize="10"
                                Click="OnFiltersNoneClick" ToolTip="Switch every filter off"/>
                        <TextBlock Text="DATA FILTERS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Samples must meet every ticked condition to be counted."
                               FontSize="10" Foreground="{DynamicResource Faint}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="0,2">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Delete filter" Click="OnDeleteFilterClick"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}"
                                                  VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       Foreground="{DynamicResource Text}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10"
                                                       Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+ Add filter" Padding="8,3" FontSize="11" Margin="0,7,0,0"
                            HorizontalAlignment="Left" Click="OnAddFilterClick"/>

                    <Border x:Name="FilterEditor" Visibility="Collapsed" Margin="0,7,0,0"
                            Background="{DynamicResource Bg}" CornerRadius="4" Padding="8"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding AxisChannels}"
                                      SelectedItem="{Binding NewFilterChannel}"
                                      ItemTemplate="{StaticResource ChannelName}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Comparisons}"
                                      SelectedItem="{Binding NewComparison}"
                                      DisplayMemberPath="Label" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,3,0"
                                         Text="{Binding NewLow, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Value"/>
                                <TextBox Grid.Column="1" Margin="3,0,0,0"
                                         Text="{Binding NewHigh, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Upper value"
                                         Visibility="{Binding NeedsSecondValue,
                                                      Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Content="Add" Padding="10,3" FontSize="11" Click="OnConfirmFilterClick"/>
                                <Button Content="Cancel" Padding="10,3" FontSize="11" Margin="5,0,0,0"
                                        Click="OnCancelFilterClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="0" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"
                    Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,6">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                 ToolTip="Filter by channel name, units or category"/>

                        <DockPanel Margin="0,7,0,0">
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding HideUnused}"
                                      VerticalAlignment="Center" FontSize="11"
                                      Foreground="{DynamicResource Muted}" Content="Hide unused"
                                      ToolTip="Hide channels that never change value in this log"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Chip}" Content="Category"
                                             IsChecked="{Binding SortByCategory}"
                                             ToolTip="Group channels by what they measure"/>
                                <RadioButton Style="{StaticResource Chip}" Content="A–Z"
                                             IsChecked="{Binding SortByName}"
                                             ToolTip="Flat alphabetical list"/>
                                <RadioButton Style="{StaticResource Chip}" Content="Plotted"
                                             IsChecked="{Binding SortByPlotted}"
                                             ToolTip="Currently plotted channels first"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,7,0,0">
                            <Button DockPanel.Dock="Left" Content="Common" Padding="8,3" FontSize="11"
                                    Click="OnPlotCommonClick"
                                    ToolTip="Plot the channels most logs are read for"/>
                            <Button DockPanel.Dock="Left" Content="All" Margin="4,0,0,0" Padding="8,3"
                                    FontSize="11" Click="OnShowAllClick"
                                    ToolTip="Plot every channel currently listed"/>
                            <Button DockPanel.Dock="Left" Content="None" Margin="4,0,0,0" Padding="8,3"
                                    FontSize="11" Click="OnShowNoneClick" ToolTip="Clear all traces"/>
                            <TextBlock Text="{Binding FilterSummary}" FontSize="10"
                                       Foreground="{DynamicResource Faint}" VerticalAlignment="Center"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                       Margin="8,0,2,0"/>
                        </DockPanel>

                        <!-- Saved selections. Click applies, right-click deletes. -->
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="+ Save" Padding="8,3" FontSize="11"
                                    VerticalAlignment="Top" Margin="4,0,0,0"
                                    Click="OnSavePresetClick"
                                    ToolTip="Save the channels currently plotted as a named preset"/>
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PresetChip}"
                                                Content="{Binding Name}"
                                                ToolTip="{Binding Summary}"
                                                Click="OnApplyPresetClick">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Overwrite with current selection"
                                                              Click="OnOverwritePresetClick"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete preset" Click="OnDeletePresetClick"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- Fixed scale for one channel. Inline rather than a dialog,
                             beside the list the channel was picked from. -->
                        <Border Margin="0,8,0,0" Background="{DynamicResource Bg}" CornerRadius="4"
                                Padding="8" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Visibility="{Binding EditingStyle, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding StyleTargetName, StringFormat=Fixed scale for {0}}"
                                           FontSize="11" Foreground="{DynamicResource Text}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                <TextBlock Text="Drawn over this range in every log, so the same channel keeps the same shape."
                                           FontSize="10" Foreground="{DynamicResource Faint}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <!-- The unit is stated because the boxes take a
                                     number in whichever system the list is showing,
                                     not in the log's own. -->
                                <TextBlock Text="{Binding StyleUnits, StringFormat=In {0}}" FontSize="10"
                                           Foreground="{DynamicResource Muted}" Margin="0,0,0,4"
                                           Visibility="{Binding HasStyleUnits,
                                                        Converter={StaticResource BoolToVis}}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,3,0" ToolTip="Bottom of the scale"
                                             Text="{Binding StyleMin, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="1" Margin="3,0,0,0" ToolTip="Top of the scale"
                                             Text="{Binding StyleMax, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <TextBlock Text="Clear both to go back to the channel's own range."
                                           FontSize="10" Foreground="{DynamicResource Faint}"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button Content="Apply" Padding="10,3" FontSize="11"
                                            Click="OnConfirmStyleClick"/>
                                    <Button Content="Cancel" Padding="10,3" FontSize="11" Margin="5,0,0,0"
                                            Click="OnCancelStyleClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Calculated channels. Once built they behave like any
                             other channel, so the list here is only the definitions. -->
                        <StackPanel Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding MathChannels}"
                                          Visibility="{Binding HasMathChannels,
                                                       Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PresetChip}"
                                                Content="{Binding Name}"
                                                ToolTip="{Binding Expression}"
                                                Click="OnEditMathChannelClick">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edit" Click="OnEditMathChannelClick"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete calculated channel"
                                                              Click="OnDeleteMathChannelClick"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding MathProblems}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Marker}" Margin="0,2,0,0"
                                       Visibility="{Binding HasMathProblems,
                                                    Converter={StaticResource BoolToVis}}"/>

                            <Button Content="ƒ  Add calculated channel" Padding="8,3" FontSize="11"
                                    HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Click="OnAddMathChannelClick"
                                    ToolTip="Define a channel from the ones the log already has"/>

                            <Border x:Name="MathEditor" Visibility="Collapsed" Margin="0,6,0,0"
                                    Background="{DynamicResource Bg}" CornerRadius="4" Padding="8"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewMathName,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Name, e.g. AFR Error"/>
                                        <TextBox Grid.Column="2" Text="{Binding NewMathUnits,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Units, e.g. AFR"/>
                                    </Grid>

                                    <TextBox Text="{Binding NewMathExpression,
                                             UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" AcceptsReturn="False"
                                             ToolTip="Channel names may contain spaces and need no quoting"/>

                                    <TextBlock Text="{Binding MathPreview}" FontSize="10" Margin="0,4,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Faint}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Button Content="Add" Padding="10,3" FontSize="11"
                                                Click="OnSaveMathChannelClick"/>
                                        <Button Content="Cancel" Padding="10,3" FontSize="11" Margin="5,0,0,0"
                                                Click="OnCancelMathChannelClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Inline naming, rather than a modal dialog. -->
                        <DockPanel x:Name="PresetNameRow" Margin="0,6,0,0" Visibility="Collapsed">
                            <Button DockPanel.Dock="Right" Content="Cancel" Padding="8,3" FontSize="11"
                                    Margin="4,0,0,0" Click="OnCancelPresetClick"/>
                            <Button DockPanel.Dock="Right" Content="Save" Padding="8,3" FontSize="11"
                                    Margin="4,0,0,0" Click="OnConfirmPresetClick"/>
                            <TextBox x:Name="PresetNameBox" MaxLength="40"
                                     KeyDown="OnPresetNameKeyDown"
                                     ToolTip="Name this selection, then press Enter"/>
                        </DockPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding ChannelView}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">

                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <ToggleButton x:Name="Head" IsChecked="True"
                                                                      Style="{StaticResource GroupHeader}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Text}"/>
                                                                <TextBlock Text="{Binding ItemCount}" FontSize="11"
                                                                           Margin="6,0,0,0" Foreground="{DynamicResource Faint}"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <ItemsPresenter x:Name="Items"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger SourceName="Head" Property="IsChecked" Value="False">
                                                            <Setter TargetName="Items" Property="Visibility"
                                                                    Value="Collapsed"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="6,3">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" CornerRadius="3" Background="Transparent" Padding="0,1">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Jump to maximum" Click="OnJumpToMaxClick"/>
                                        <MenuItem Header="Jump to minimum" Click="OnJumpToMinClick"/>
                                        <Separator/>
                                        <MenuItem Header="Plot only this channel" Click="OnPlotOnlyClick"/>
                                        <Separator/>
                                        <!-- Swatches are built when the submenu opens: the
                                             palette belongs to the scheme, which the row does
                                             not know about, and it changes under it. -->
                                        <MenuItem Header="Colour" SubmenuOpened="OnColourMenuOpened"/>
                                        <MenuItem Header="Fixed scale…" Click="OnPinScaleClick"
                                                  ToolTip="Draw this channel over a range you choose, in every log"/>

                                        <!-- Drawing only. Everything that judges
                                             the engine reads the channel as
                                             logged, which the tooltip says out
                                             loud because it is the one thing
                                             somebody might reasonably assume
                                             otherwise. -->
                                        <MenuItem Header="Smoothing"
                                                  ToolTip="Quietens a noisy trace. Only how it is drawn — every measurement still uses the channel as logged">
                                            <MenuItem Header="None" Click="OnSmoothClick" Tag="None"
                                                      ToolTip="As logged"/>
                                            <MenuItem Header="Light" Click="OnSmoothClick" Tag="Light"
                                                      ToolTip="Median of 5 samples — takes the fuzz off"/>
                                            <MenuItem Header="Medium" Click="OnSmoothClick" Tag="Medium"
                                                      ToolTip="Median of 15 — a noisy sensor becomes a readable line"/>
                                            <MenuItem Header="Strong" Click="OnSmoothClick" Tag="Strong"
                                                      ToolTip="Median of 51 — the shape only"/>
                                        </MenuItem>
                                        <MenuItem Header="Back to automatic" Click="OnClearStyleClick"
                                                  ToolTip="Take the scheme's colour, the channel's own range and the trace as logged again"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"
                                              VerticalAlignment="Center"/>

                                    <Rectangle Grid.Column="1" Width="3" Height="16" Margin="6,0,7,0"
                                               RadiusX="1.5" RadiusY="1.5" Fill="{Binding Brush}"
                                               ToolTip="{Binding ScaleNote}">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                        <Setter Property="Opacity" Value="0.25"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                      <DockPanel>
                                        <!-- Marks a channel the user defined rather than the
                                             logger recorded. -->
                                        <TextBlock DockPanel.Dock="Left" Text="ƒ" FontSize="11"
                                                   Margin="0,0,4,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}"
                                                   ToolTip="Calculated channel"
                                                   Visibility="{Binding IsCalculated,
                                                                Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFlat}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                      </DockPanel>
                                        <TextBlock Text="{Binding Range}" FontSize="10"
                                                   Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Capped so a long value can never push the
                                         jump buttons off the edge of the panel. -->
                                    <TextBlock Grid.Column="3" Text="{Binding Value}"
                                               VerticalAlignment="Center" Margin="8,0,2,0"
                                               MaxWidth="96" TextTrimming="CharacterEllipsis"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{Binding Brush}"/>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="4,0,0,0">
                                        <Button Style="{StaticResource JumpButton}" Content="&#x25B2;"
                                                Click="OnJumpToMaxClick"
                                                IsEnabled="{Binding CanJump}"
                                                ToolTip="Jump to this channel's maximum"/>
                                        <Button Style="{StaticResource JumpButton}" Content="&#x25BC;"
                                                Click="OnJumpToMinClick"
                                                IsEnabled="{Binding CanJump}"
                                                ToolTip="Jump to this channel's minimum"/>
                                    </StackPanel>
                                </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Hovering the trace in the plot marks its row here. -->
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Line}"/>

            <!-- The plot, with the find bar above it. Docked rather than put in
                 the toolbar: it belongs to the recording being read, appears only
                 when asked for, and takes the width it needs for a condition. -->
            <DockPanel Grid.Column="2"
                       Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                        Padding="8,6"
                        Visibility="{Binding Finding, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Find" FontSize="11"
                                   Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <Button DockPanel.Dock="Right" Content="✕" Padding="6,2" FontSize="10"
                                Margin="6,0,0,0" Click="OnCloseFindClick" ToolTip="Close the find bar"/>
                        <Button DockPanel.Dock="Right" Content="Next ▸" Padding="8,2" FontSize="11"
                                Margin="4,0,0,0" Click="OnFindNextClick"
                                IsEnabled="{Binding CanStepFindings}"/>
                        <Button DockPanel.Dock="Right" Content="◂ Prev" Padding="8,2" FontSize="11"
                                Margin="4,0,0,0" Click="OnFindPreviousClick"
                                IsEnabled="{Binding CanStepFindings}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FindSummary}" FontSize="10"
                                   Foreground="{DynamicResource Faint}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        <TextBox x:Name="FindBox" MinWidth="180"
                                 Text="{Binding FindCondition, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnFindBoxKeyDown"
                                 ToolTip="A condition, in the same syntax as a calculated channel — RPM &gt; 4000 &amp;&amp; TPS &gt; 80"/>
                    </DockPanel>
                </Border>

                <local:LogPlot x:Name="Plot" Cursor="Cross"/>
            </DockPanel>
            <local:HistogramView Grid.Column="2" x:Name="Histogram"
                                 Visibility="{Binding ShowHistogram, Converter={StaticResource BoolToVis}}"/>
            <local:ScatterView Grid.Column="2" x:Name="Scatter" Cursor="Cross"
                               Visibility="{Binding ShowScatter, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Gauge mode: the firmware's own dials over a live connection. -->
        <Grid Visibility="{Binding InGaugeMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Which gauges to show. Three hundred are defined; the firmware's
                 own front page decides the first eight. -->
            <Border Grid.Column="0" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,10,6,10">
                    <TextBox DockPanel.Dock="Top" Margin="0,0,4,6"
                             Text="{Binding GaugeSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             ToolTip="Search by name, channel or category"/>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,6,4,0" FontSize="11"
                               Foreground="{DynamicResource Muted}"
                               Text="{Binding GaugeSummary}" TextWrapping="Wrap"/>
                    <Button DockPanel.Dock="Bottom" Content="Clear peaks" Margin="0,6,4,0"
                            Click="OnResetGaugePeaksClick"
                            ToolTip="Forget the high and low markers on every dial"/>

                    <ListBox ItemsSource="{Binding GaugeChoices}" BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}" Margin="0,8,0,3"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsShown}" IsEnabled="{Binding IsConnected}"
                                          Margin="0,2" ToolTip="{Binding Spec.Channel}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Line}"/>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="10">
                <ItemsControl ItemsSource="{Binding Dashboard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:GaugeView Width="160" Height="180" Margin="5"
                                             Spec="{Binding Spec}" Value="{Binding Value}"
                                             Peak="{Binding Peak}" Trough="{Binding Trough}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Nothing to show until a connection says what the ECU is. -->
            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" TextAlignment="Center"
                       Text="Connect to an ECU to see its gauges.&#10;The firmware supplies the dials, their ranges and their limits."
                       Visibility="{Binding NoGauges, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Calibration mode: the tune as it is in the ECU. -->
        <Grid Visibility="{Binding InCalibrationMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"
                    Visibility="{Binding HasEcuTune, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="10">
                    <!-- The tune has two halves: the tables, and the several
                         hundred settings that are not tables. Both come off the
                         same controller and neither is a mode of the other. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Style="{StaticResource Chip}" Content="Tables" GroupName="TuneHalf"
                                     IsChecked="{Binding ShowEcuTables}"
                                     ToolTip="The maps: VE, ignition, AFR target"/>
                        <RadioButton Style="{StaticResource Chip}" Content="Settings" GroupName="TuneHalf"
                                     IsChecked="{Binding ShowSettingsPages}"
                                     IsEnabled="{Binding HasSettingsPages}"
                                     ToolTip="Everything else the firmware lets you change"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="TABLES IN THE ECU" FontSize="10"
                               FontWeight="SemiBold" Foreground="{DynamicResource Muted}"
                               Margin="0,0,0,6"
                               Visibility="{Binding ShowEcuTables, Converter={StaticResource BoolToVis}}"/>
                    <TextBox x:Name="TableSearch" DockPanel.Dock="Top" Margin="0,0,0,6"
                             Text="{Binding EcuTableSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             Visibility="{Binding ShowEcuTables, Converter={StaticResource BoolToVis}}"
                             ToolTip="Filter by name — try VE, ignition, boost"/>

                    <!-- The settings pages, as the firmware groups them. -->
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding SettingsMenu}"
                             SelectedItem="{Binding OpenMenuEntry}"
                             BorderThickness="0" Background="Transparent" MaxHeight="10000"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding ShowSettingsPages, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Style.Triggers>
                                    <!-- A heading names the group beneath it and is
                                         not something to open. -->
                                    <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           Margin="2,3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                    <Setter Property="FontSize" Value="10"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Margin" Value="2,9,2,2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="11"
                               Foreground="{DynamicResource Muted}" Text="{Binding EcuTableSummary}"/>

                    <!-- Biggest first: a firmware's main maps are its
                         finest-grained ones, and rusEFI declares seventy-six in
                         an order that suits the file rather than the reader. -->
                    <ListBox ItemsSource="{Binding EcuTableChoices}" SelectedItem="{Binding SelectedEcuTable}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding ShowEcuTables, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                           Margin="2,3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Line}"
                          Visibility="{Binding HasEcuTune, Converter={StaticResource BoolToVis}}"/>

            <DockPanel Grid.Column="2" Visibility="{Binding HasEcuTune, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Margin="12,10,12,8" FontSize="11"
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                           Text="{Binding EcuTuneSummary}"/>

                <!-- Sending and burning are separate acts because they are
                     separate on the ECU: a write takes effect at once and is
                     forgotten at the next power cycle, a burn is permanent. -->
                <DockPanel DockPanel.Dock="Bottom" Margin="12,8,12,10" LastChildFill="False">
                    <!-- The table half. -->
                    <Button DockPanel.Dock="Left" Content="Send to ECU" Margin="0,0,8,0"
                            Click="OnWriteTableClick"
                            IsEnabled="{Binding CanWriteTable}"
                            Visibility="{Binding ShowEcuTables, Converter={StaticResource BoolToVis}}"
                            ToolTip="Writes the changed cells into the ECU's working memory. Takes effect immediately; lost at the next power cycle unless burned."/>

                    <Button DockPanel.Dock="Left" Content="Burn" Margin="0,0,8,0"
                            Click="OnBurnTableClick"
                            IsEnabled="{Binding CanBurn}"
                            Visibility="{Binding ShowEcuTables, Converter={StaticResource BoolToVis}}"
                            ToolTip="Commits the page to the ECU's flash. This survives a power cycle."/>

                    <Button DockPanel.Dock="Left" Content="Revert" Margin="0,0,14,0"
                            Click="OnRevertTableClick"
                            IsEnabled="{Binding HasTableChanges}"
                            Visibility="{Binding ShowEcuTables, Converter={StaticResource BoolToVis}}"
                            ToolTip="Puts every cell back to what the ECU said."/>

                    <!-- And the settings half, which sends different bytes and so
                         has its own buttons rather than sharing these. -->
                    <Button DockPanel.Dock="Left" Content="Send to ECU" Margin="0,0,8,0"
                            Click="OnWriteSettingsClick"
                            IsEnabled="{Binding CanWriteSettings}"
                            Visibility="{Binding ShowSettingsPages, Converter={StaticResource BoolToVis}}"
                            ToolTip="Writes the changed settings into the ECU's working memory. Takes effect immediately; lost at the next power cycle unless burned."/>

                    <Button DockPanel.Dock="Left" Content="Burn" Margin="0,0,8,0"
                            Click="OnBurnSettingsClick"
                            IsEnabled="{Binding CanBurnSettings}"
                            Visibility="{Binding ShowSettingsPages, Converter={StaticResource BoolToVis}}"
                            ToolTip="Commits the pages that were written to the ECU's flash. This survives a power cycle."/>

                    <Button DockPanel.Dock="Left" Content="Revert settings" Margin="0,0,14,0"
                            Click="OnRevertSettingsClick"
                            IsEnabled="{Binding HasSettingChanges}"
                            Visibility="{Binding ShowSettingsPages, Converter={StaticResource BoolToVis}}"
                            ToolTip="Puts every changed setting back to what the ECU said."/>

                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowEcuTables, Converter={StaticResource BoolToVis}}"
                               Text="{Binding TableEditSummary}"/>

                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowSettingsPages, Converter={StaticResource BoolToVis}}"
                               Text="{Binding SettingsSummary}"/>
                </DockPanel>

                <!-- The tools, so the table can be worked without knowing the
                     keyboard. Every one of them acts on the selection, and none
                     of them sends anything. -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="10,7" CornerRadius="5"
                        Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        Visibility="{Binding ShowEcuTables, Converter={StaticResource BoolToVis}}">
                    <WrapPanel>
                        <TextBlock Text="Add / subtract" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/>
                        <Button Content="{Binding TableNudgeDownLabel}" MinWidth="52"
                                Click="OnNudgeDownClick" Margin="0,0,3,0"
                                ToolTip="Takes that much off every selected cell, in the table's own units"/>
                        <Button Content="{Binding TableNudgeUpLabel}" MinWidth="52"
                                Click="OnNudgeUpClick" Margin="0,0,6,0"
                                ToolTip="Adds that much to every selected cell, in the table's own units"/>
                        <TextBlock Text="by" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,4,0"/>
                        <TextBox Width="52" Margin="0,0,4,0" HorizontalContentAlignment="Right"
                                 GotKeyboardFocus="OnFieldFocused"
                                 PreviewMouseLeftButtonDown="OnFieldClicked"
                                 Text="{Binding TableNudge, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="How much one press is worth, in the table's own units. Defaults to the firmware's storage resolution — anything finer is rounded away by the ECU."/>
                        <TextBlock Text="{Binding TableStepUnits}" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,18,0"/>

                        <TextBlock Text="Scale by" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/>
                        <Button Content="{Binding TableScaleDownLabel}" MinWidth="52"
                                Click="OnScaleDownClick" Margin="0,0,3,0"
                                ToolTip="Makes every selected cell that much smaller, as a proportion of what it already is"/>
                        <Button Content="{Binding TableScaleUpLabel}" MinWidth="52"
                                Click="OnScaleUpClick" Margin="0,0,6,0"
                                ToolTip="Makes every selected cell that much larger, as a proportion of what it already is"/>
                        <TextBlock Text="by" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,4,0"/>
                        <TextBox Width="44" Margin="0,0,4,0" HorizontalContentAlignment="Right"
                                 GotKeyboardFocus="OnFieldFocused"
                                 PreviewMouseLeftButtonDown="OnFieldClicked"
                                 Text="{Binding TableScaleStep, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="% of the value" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,18,0"/>

                        <TextBlock Text="Set to" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/>
                        <TextBox x:Name="SetValueBox" Width="60" Margin="0,0,4,0"
                                 HorizontalContentAlignment="Right"
                                 GotKeyboardFocus="OnFieldFocused"
                                 PreviewMouseLeftButtonDown="OnFieldClicked"
                                 KeyDown="OnSetValueKeyDown"
                                 ToolTip="Type a value and press Enter, or use Apply"/>
                        <Button Content="Apply" Click="OnSetValueClick" Margin="0,0,16,0"/>

                        <Button Content="Interpolate" Click="OnInterpolateClick" Margin="0,0,6,0"
                                ToolTip="Fills the inside of the selection from its ends — select three or more cells across or down"/>
                        <Button Content="Revert cells" Click="OnRevertCellsClick"
                                IsEnabled="{Binding HasTableChanges}"
                                ToolTip="Puts just the selected cells back to what the ECU said"/>
                    </WrapPanel>
                </Border>

                <!-- What it would become, which is the question actually being
                     asked before anything is sent. -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="10,7" CornerRadius="5"
                        Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        Visibility="{Binding ShowEcuTables, Converter={StaticResource BoolToVis}}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding TableChangeWhere}"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,14,0"/>

                        <TextBlock DockPanel.Dock="Left" Text="{Binding TableChangeFrom}"
                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="15"
                                   Foreground="{DynamicResource Muted}"/>

                        <TextBlock DockPanel.Dock="Left" Text="→" VerticalAlignment="Center"
                                   FontSize="14" Margin="8,0" Foreground="{DynamicResource Muted}"
                                   Visibility="{Binding HasTableChangePreview, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock DockPanel.Dock="Left" Text="{Binding TableChangeTo}"
                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                   Visibility="{Binding HasTableChangePreview, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock DockPanel.Dock="Left" Text="{Binding TableChangeDelta}"
                                   VerticalAlignment="Center" FontSize="11" Margin="14,0,0,0"
                                   Foreground="{DynamicResource Muted}"/>

                        <TextBlock DockPanel.Dock="Right" Text="{Binding TableChangeState}"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Muted}"/>
                    </DockPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Margin="12,0,12,0" FontSize="10"
                           Foreground="{DynamicResource Muted}"
                           Visibility="{Binding ShowEcuTables, Converter={StaticResource BoolToVis}}"
                           Text="Click or drag to select · arrows move · shift extends · + − nudge · PgUp/PgDn scale by 1% (shift 5%) · Esc undoes the selection"/>

                <!-- Shown from either half: the tables list, or a settings
                     menu entry that names a table. -->
                <local:TuneTableView x:Name="TuneTable"
                                     Table="{Binding SelectedEcuTable}"
                                     Edit="{Binding TableEdit}"
                                     Selection="{Binding SelectedCells, Mode=TwoWay}"
                                     Visibility="{Binding ShowTableView, Converter={StaticResource BoolToVis}}"/>

                <!--
                    A curve: warmup enrichment, cranking pulsewidth, injector
                    dead time. The firmware calls these curves rather than tables
                    because that is how they are read and changed — a lump in a
                    warmup line is a stumble at one coolant temperature, and it
                    is the shape that says so. A grid of ten cells would hide
                    exactly what a person opens this to see.
                -->
                <DockPanel x:Name="Curves" DockPanel.Dock="Top" MinHeight="340"
                           Visibility="{Binding ShowCurves, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Margin="18,0,18,6" FontSize="10"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               Text="Drag a point to move it · shift-drag moves the breakpoint · arrows nudge by one step, ctrl for ten"/>

                    <DockPanel DockPanel.Dock="Bottom" Margin="18,6,18,10" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Send curve to ECU" Padding="12,5" Margin="0,0,8,0"
                                Click="OnSendCurveClick" IsEnabled="{Binding CanWriteCurve}"
                                ToolTip="Writes the moved points to the controller's working memory"/>
                        <Button DockPanel.Dock="Left" Content="Burn" Padding="12,5" Margin="0,0,8,0"
                                Click="OnBurnSettingsClick" IsEnabled="{Binding CanBurnSettings}"
                                ToolTip="Commits what has been sent to flash, so it survives a power cycle"/>
                        <Button DockPanel.Dock="Left" Content="Revert curve" Padding="12,5" Margin="0,0,14,0"
                                Click="OnRevertCurveClick" IsEnabled="{Binding HasCurveChanges}"
                                ToolTip="Puts every point back to what the ECU holds"/>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource Muted}" Text="{Binding CurveSummary}"/>
                    </DockPanel>

                    <!-- One plot per curve the page names: an MS3 puts two or
                         more on 25 of its pages, and two at 300 pixels each do
                         not fit a window, so they scroll. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding OpenCurves}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel MinHeight="300">
                                    <TextBlock DockPanel.Dock="Top" Margin="18,6,18,2"
                                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text}"
                                               Text="{Binding Title}"/>

                                    <local:CurveView Margin="12,0,12,0" Curve="{Binding}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- A settings page, laid out from the firmware's description of
                     it. One row per field, with the control chosen by what the
                     constant behind it turns out to be. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowSettingsFields, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="18,4,18,20" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding OpenDialog.Title}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="Part of this page is a live graph or a lamp, which is not drawn here."
                                   FontSize="10" Foreground="{DynamicResource Marker}" TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding OpenDialog.IsPartial, Converter={StaticResource BoolToVis}}"/>

                        <ItemsControl ItemsSource="{Binding OpenDialog.Visible}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" Foreground="{DynamicResource Text}"/>

                                        <!-- A changed field is outlined, as a changed
                                             table cell is: the outline says it is not
                                             what the ECU holds. -->
                                        <TextBox Grid.Column="1" FontSize="12"
                                                 Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{Binding Original, StringFormat=In the ECU: {0}}">
                                            <TextBox.Style>
                                                <!-- BasedOn, or this replaces the
                                                     application's own TextBox style
                                                     outright: an explicit style does
                                                     not inherit the implicit one, and
                                                     what is lost is the whole theme. -->
                                                <Style TargetType="TextBox"
                                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Number">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <ComboBox Grid.Column="1" FontSize="12"
                                                  ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding Value}"
                                                  ToolTip="{Binding Original, StringFormat=In the ECU: {0}}">
                                            <ComboBox.Style>
                                                <!-- The same: without BasedOn this drops
                                                     the application's ComboBox style and
                                                     with it the template, so the control
                                                     falls back to the system's own — a
                                                     white box wearing the theme's light
                                                     text, which is why these two were
                                                     the only unreadable things on the
                                                     page. -->
                                                <Style TargetType="ComboBox"
                                                       BasedOn="{StaticResource {x:Type ComboBox}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Choice">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>

                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="ReadOnly">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="7,0,0,0">
                                            <TextBlock Text="{Binding Units}" FontSize="10"
                                                       Foreground="{DynamicResource Faint}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Shown because the firmware did not say
                                                 whether it applies, rather than because
                                                 it said that it does. -->
                                            <TextBlock Text="?" FontSize="11" Margin="5,0,0,0"
                                                       Foreground="{DynamicResource Marker}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="This firmware did not say whether the setting applies to your tune, so it is shown rather than hidden."
                                                       Visibility="{Binding IsUncertain,
                                                                    Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!--
                What Calibration means on a standard vehicle.

                An OBD2 car has no tune to read and never will — the standard
                exposes readings and diagnostics, not calibration — so this tab
                used to tell somebody who was plainly connected to "connect to an
                ECU". Fault codes are the thing OBD2 offers that is about the car
                rather than about this moment, which is what this tab is for.

                Spanning all three columns because the table list and its splitter
                are collapsed without a tune, and a column definition does not
                shrink just because what is in it is hidden — left in one column
                this would sit behind a 260-pixel gutter.
            -->
            <local:FaultsPanel x:Name="CalibrationFaults" Grid.Column="0" Grid.ColumnSpan="3"
                               Visibility="{Binding IsObd2Live, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" TextAlignment="Center"
                       Text="Connect to an ECU to read its tune.&#10;Tables come off the controller itself, not from a saved file."
                       Visibility="{Binding ShowNoTuneNotice, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Guide mode: how to use the application, carried inside it. -->
        <Grid Visibility="{Binding InGuideMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Sections, with a search over all of them above. -->
            <Border Grid.Column="0" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Margin="8,8,8,6"
                             Text="{Binding GuideSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             ToolTip="Search every section"/>

                    <ListBox ItemsSource="{Binding GuideSections}"
                             SelectedItem="{Binding GuideSection}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Padding="2,3"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Line}"/>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <!-- Capped, because a line of prose past about ninety characters
                     is measurably harder to come back to at the next line. -->
                <StackPanel Margin="22,18,22,26" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding GuideHeading}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding GuideBlurb}" FontSize="12" Margin="0,4,0,16"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding GuideEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,18">
                                    <!-- The shortcut sits against the heading it
                                         belongs to. Docked to the right of the row
                                         it ends up an inch of empty space away from
                                         the thing it names. Wrapping, so a long
                                         heading pushes it to the next line rather
                                         than squeezing it. -->
                                    <WrapPanel Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <Border CornerRadius="3" Padding="6,1"
                                                Margin="9,1,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource Bg}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                Visibility="{Binding HasKeys,
                                                             Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Keys}" FontSize="10"
                                                       FontFamily="Consolas, Courier New, monospace"
                                                       Foreground="{DynamicResource Muted}"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Body}" FontSize="12.5"
                                               TextWrapping="Wrap" LineHeight="19"
                                               Foreground="{DynamicResource Text}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        </Grid>
    </DockPanel>
</Window>




