<Window x:Class="OpenLogViewer.App.InsightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenLogViewer.App"
        Title="Insights" Height="720" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}">

    <DockPanel>
        <!--
            What the findings rest on, said before the findings. A reader who
            does not know how much running went into these cannot weigh them.
        -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Subheading}" FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Copy all" Padding="12,4" Margin="0,0,8,0"
                        Click="OnCopyClick"
                        ToolTip="Puts every finding on the clipboard, numbers included"/>
                <Button DockPanel.Dock="Left" Content="Re-run" Padding="12,4"
                        Click="OnRefreshClick"
                        ToolTip="Measures the log again, which matters on a live session"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Muted}" Text="{Binding Tally}"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="4"
                                Background="{DynamicResource PanelAlt}"
                                BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Badge}"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Accent}"/>
                                    <TextBlock Text="{Binding Topic}" FontSize="10"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Muted}"/>
                                </DockPanel>

                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Margin="0,5,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text}"/>

                                <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,4,0,0"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Foreground="{DynamicResource Text}"/>

                                <!-- The arithmetic, so the conclusion can be argued with. -->
                                <TextBlock Text="{Binding Evidence}" FontSize="10" Margin="0,6,0,0"
                                           TextWrapping="Wrap" FontFamily="Consolas"
                                           Foreground="{DynamicResource Muted}"
                                           Visibility="{Binding HasEvidence,
                                                        Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
