<Window x:Class="OpenLogViewer.App.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tuning project" Height="700" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}">

    <DockPanel>
        <!--
            The vehicle first, because everything below belongs to one and a
            project read against the wrong car is worse than no project.
        -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Which vehicle" FontSize="11" Margin="0,0,0,6"
                           Foreground="{DynamicResource Muted}"/>
                <DockPanel LastChildFill="False">
                    <ComboBox x:Name="Vehicles" DockPanel.Dock="Left" Width="300" IsEditable="True"
                              ToolTip="Pick a project, or type a name to start one"/>
                    <Button DockPanel.Dock="Left" Content="Open" Margin="8,0,0,0" Padding="14,4"
                            Click="OnOpenClick"/>
                    <Button DockPanel.Dock="Right" Content="Record this log" Padding="14,4"
                            Click="OnRecordClick"
                            ToolTip="Runs the insights over the log in hand and keeps what they found"/>
                </DockPanel>

                <!--
                    The note is what turns a row of findings into evidence about
                    a change: "after VE +4% above 150 kPa" is the difference
                    between a record and a pile of measurements.
                -->
                <TextBox x:Name="Note" Margin="0,8,0,0" Padding="6,4"
                         ToolTip="What this sitting was — what you changed before it, what you are testing"/>
                <TextBlock Text="What changed before this log, if anything" FontSize="10" Margin="2,3,0,0"
                           Foreground="{DynamicResource Muted}"/>

                <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,8,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource Text}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Copy" Padding="12,4" Margin="0,0,8,0"
                        Click="OnCopyClick"
                        ToolTip="Puts the whole project on the clipboard, which is what to paste to an assistant"/>
                <Button DockPanel.Dock="Left" Content="Open the folder" Padding="12,4"
                        Click="OnFolderClick"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Muted}"
                           Text="Nothing here is sent anywhere. The file is yours."/>
            </DockPanel>
        </Border>

        <!--
            The project as prose rather than as a grid of fields. It is read the
            way notes are read, and it is the same text an assistant is handed.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <TextBox x:Name="Brief"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource Text}"/>
        </ScrollViewer>
    </DockPanel>
</Window>
