<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenLogViewer.Core\OpenLogViewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenLogViewer.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only to name the COM ports in the connect menu, which is the difference
         between picking a Bluetooth module and guessing. Windows-only, which is
         why it is here and not in the core. -->
    <PackageReference Include="System.Management" Version="10.0.10" />

    <!-- The local MCP server (src/Mcp/), so an AI agent can drive the window.
         Off by default and bound to loopback; see docs/mcp-server.md. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <!--
    Required to use WebApplication/Kestrel — which is what hosts the MCP server's
    HTTP transport — from a non-Sdk.Web project. This is Microsoft's documented
    pattern for embedding ASP.NET Core in a desktop app rather than the other way
    around. Microsoft.Extensions.Hosting is deliberately not referenced
    explicitly: the shared framework already carries it, and naming it as well
    earns NU1510.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The Windows version is named so the Bluetooth LE APIs are available: a
      great many OBD2 adapters are BLE-only, and those never appear as a COM
      port. SupportedOSPlatformVersion is left well below it so naming the SDK
      does not raise the Windows this will run on — everything used from it has
      been there since 2017.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Icon shown by Explorer, the desktop and the taskbar. -->
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>

    <AssemblyTitle>OpenLogViewer</AssemblyTitle>
    <Product>OpenLogViewer</Product>
    <Description>Datalog viewer for MegaSquirt, TunerStudio and other ECU logs.</Description>
    <Company>OpenLogViewer contributors</Company>
    <Copyright>Copyright (c) 2026 OpenLogViewer contributors</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded so the window can set it explicitly. -->
    <Resource Include="AppIcon.ico" />
  </ItemGroup>

</Project>
