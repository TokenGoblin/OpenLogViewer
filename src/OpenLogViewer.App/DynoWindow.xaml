<Window x:Class="OpenLogViewer.App.DynoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:OpenLogViewer.App"
        Title="Dyno"
        Height="820" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,2"/>
            <EventSetter Event="GotKeyboardFocus" Handler="OnFieldFocused"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnFieldClicked"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ the car, and what the recording already knows ============ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,4"
                           Text="The car"/>

                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                           Text="Only what the recording cannot say. Everything else is read from the log and its tune, below."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Mass"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="Mass" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="MassNote" Style="{StaticResource Label}"
                               Margin="8,0,0,0" Opacity="0.7" Text="kg, everything aboard"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Final drive"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="FinalDrive" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="FinalNote" Style="{StaticResource Label}"
                               Margin="8,0,0,0" Opacity="0.7"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Gear ratios"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="Ratios"
                               HorizontalContentAlignment="Left" Margin="0,2"
                               TextChanged="OnChanged"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Tyre"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TyreText"
                               HorizontalContentAlignment="Left" Margin="0,2"
                               ToolTip="A tyre size, or a rolling diameter in mm if you have measured one."
                               TextChanged="OnChanged"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="Driveline loss"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="Loss" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Label}"
                               Margin="8,0,0,0" Opacity="0.7" Text="% — nothing can measure it"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Label}" Text="Displacement"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" x:Name="Litres" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Label}"
                               Margin="8,0,0,0" Opacity="0.7" Text="litres"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Label}" Text="Injectors"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" x:Name="InjectorCc" Style="{StaticResource Field}"
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Label}"
                               Margin="8,0,0,0" Opacity="0.7" Text="cc/min each, on a bench"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Label}" Text="BSFC"/>
                    <TextBox   Grid.Row="7" Grid.Column="1" x:Name="Bsfc" Style="{StaticResource Field}"
                               ToolTip="Pounds of fuel per horsepower per hour."
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Label}"
                               Margin="8,0,0,0" Opacity="0.7" Text="lb/hp·h"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource Label}" Text="Cylinder filling"/>
                    <TextBox   Grid.Row="8" Grid.Column="1" x:Name="Ve" Style="{StaticResource Field}"
                               ToolTip="Volumetric efficiency: how full a cylinder gets, before boost."
                               TextChanged="OnChanged"/>
                    <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource Label}"
                               Margin="8,0,0,0" Opacity="0.7" Text="% — only if nothing measured it"/>
                </Grid>

                <Button Content="Forget what I entered" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Padding="8,3" Click="OnForgetClick"
                        ToolTip="Puts every field back to what the tune says."/>

                <TextBlock Style="{StaticResource Heading}" Text="What this recording knows"/>

                <ItemsControl x:Name="Knowledge">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Note}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Opacity="0.75"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                                <Border Grid.Column="2" CornerRadius="3" Padding="5,0" Margin="4,0,0,0"
                                        Background="{Binding Tint}">
                                    <TextBlock Text="{Binding Source}" FontSize="10.5"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ the pulls and the sheet ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,6"/>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" x:Name="Pulls" SelectionChanged="OnPullChanged"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="Gear"/>
                    <ComboBox x:Name="GearBox" Width="120" SelectionChanged="OnGearChanged"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource Line}">
                <app:DynoView x:Name="Sheet"/>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock x:Name="Readout" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock x:Name="Basis" TextWrapping="Wrap" Opacity="0.75" FontSize="11.5"/>
                <ItemsControl x:Name="Cautions" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.85"
                                       FontSize="11.5" Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
